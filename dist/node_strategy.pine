//@version=6

// Futures are margined, and the broker emulator is not: left alone it wants
// the whole notional in cash, which one MNQ contract already exceeds, and
// every order is rejected without a word. Two percent is fifty to one, which
// is what a broker's day margin on a micro looks like. MARGIN_PCT in the
// portfolio mirrors this number; change both or neither.
// Every order carries its own qty, sized by risk management, so Properties'
// default order size is never read. Declared in contracts anyway: left at a
// percentage of equity it reads like a second risk setting, and changing it
// does nothing.
strategy("Node - v2.0.0-dev.1", overlay = true, initial_capital = 50000,
     margin_long = 2, margin_short = 2,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ════════════════════════════════  SHARED  ══════════════════════════════
// See docs/shared.md.

// ─────────────────────────────  CONSTANTS  ──────────────────────────────

SRC_TF       = "240"                    // M object source timeframe: H4
TF_MS        = 4 * 60 * 60 * 1000       // length of one H4 candle, in ms
ID_TF        = "60"                     // ID object source timeframe: H1
ID_TF_MIN    = 60                       // length of one H1 candle, in minutes
ID_TF_MS     = 60 * 60 * 1000
EVAL_TF      = "5"                      // everything is judged on this grid
EVAL_MS      = 5 * 60 * 1000
NY_START_MIN = 9 * 60                   // 09:00 ET, first candle of the NY set
NY_END_MIN   = 17 * 60                  // 17:00 ET, session close
MS_DAY       = 24 * 60 * 60 * 1000
NY_TZ        = "America/New_York"
NY_OPEN_MIN  = 9 * 60 + 30              // 09:30 ET, in minutes from midnight
SESS_OPEN_MIN = 18 * 60                 // 18:00 ET, when the session opens

// ─────────────────────────────  INPUTS  ─────────────────────────────────

G_COMMON = "Common"
G_V      = "Objects · V objects"

excludedInput = input.text_area(
     "2025-11-28, 2025-12-24, 2026-11-27, 2026-12-24",
     "Skipped sessions", group = G_COMMON,
     tooltip = "Sessions the system sits out entirely: no objects are created and no setup arms, so nothing trades. One date per entry, comma or line separated, and the date is the session's closing day in New York time — the session that closes on it opened at 18:00 the evening before. Meant for holiday half sessions. Full closures need no entry: no bars, nothing to draw. The diagnostics table says how many dates it read and whether the session on screen is one of them.")
warnGrid = input.bool(true, "Warn when the chart does not fit the grid", group = G_COMMON)
showDiag = input.bool(false, "Diagnostics table", group = G_COMMON,
     tooltip = "Reports the state behind the drawings on the last bar: what the feeds say the session is, when the last turnover happened, and where each object stands.")

enableM      = input.bool(true, "Enable M objects", group = G_V,
     tooltip = "Off means no M object is ever created, not merely hidden. It also removes one of the two ways a NY ID object can be triggered, the other being an ID object getting absorbed.")
markColor    = input.color(color.new(color.orange, 0), "M object color", group = G_V)
lifetimeDays = input.int(3, "M object lifetime (days)", minval = 1, group = G_V,
     tooltip = "Counted from the source candle. An untouched M object is removed once it expires.")

enableId     = input.bool(true, "Enable ID objects", group = G_V)
idColor      = input.color(color.new(color.blue, 0), "ID object color", group = G_V)

enableNyId   = input.bool(true, "Enable NY ID object", group = G_V)
nyIdColor    = input.color(color.new(color.purple, 0), "NY ID object color", group = G_V)

// ────────────────────────  SKIPPED SESSIONS  ────────────────────────────

var array<int> excludedDates = array.new<int>()
if barstate.isfirst
    parts = str.split(str.replace_all(excludedInput, "\n", ","), ",")
    for i = 0 to array.size(parts) - 1
        raw   = array.get(parts, i)
        clean = str.replace_all(str.replace_all(str.replace_all(raw, "-", ""), "/", ""), " ", "")
        num   = str.tonumber(clean)
        if not na(num)
            array.push(excludedDates, int(num))

// ──────────────────────────  EVALUATION GRID  ───────────────────────────
// Coarser charts are split into five-minute intrabars, finer ones bucketed.

coarse = timeframe.in_seconds() > 300
evalTf = coarse ? EVAL_TF : timeframe.period

[ltfT, ltfO, ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(
     syminfo.tickerid, evalTf, [time, open, high, low, close, volume])

var array<int>   slT = array.new<int>()
var array<float> slO = array.new<float>()
var array<float> slH = array.new<float>()
var array<float> slL = array.new<float>()
var array<float> slC = array.new<float>()
var array<float> slV = array.new<float>()

var int   bkT = na                      // bucket under construction, used
var float bkO = na                      // only on charts finer than the grid
var float bkH = na
var float bkL = na
var float bkV = 0.0

array.clear(slT)
array.clear(slO)
array.clear(slH)
array.clear(slL)
array.clear(slC)
array.clear(slV)

if coarse
    if array.size(ltfT) > 0
        for i = 0 to array.size(ltfT) - 1
            array.push(slT, array.get(ltfT, i))
            array.push(slO, array.get(ltfO, i))
            array.push(slH, array.get(ltfH, i))
            array.push(slL, array.get(ltfL, i))
            array.push(slC, array.get(ltfC, i))
            array.push(slV, array.get(ltfV, i))
else
    if na(bkT)
        bkT := time - time % EVAL_MS
        bkO := open
        bkH := high
        bkL := low
        bkV := 0.0
    bkH := math.max(bkH, high)
    bkL := math.min(bkL, low)
    bkV := bkV + nz(volume)
    if time_close % EVAL_MS == 0
        array.push(slT, bkT)
        array.push(slO, bkO)
        array.push(slH, bkH)
        array.push(slL, bkL)
        array.push(slC, close)
        array.push(slV, bkV)
        bkT := na

// ─────────────────────────  NEW YORK CLOCK  ─────────────────────────────

// The session a moment belongs to. Pushing 18:00 ET to midnight turns the
// exchange session into a plain calendar date, daylight saving included.
sessionDay(int t) =>
    shifted = t + (1440 - SESS_OPEN_MIN) * 60000
    year(shifted, NY_TZ) * 10000 + month(shifted, NY_TZ) * 100 + dayofmonth(shifted, NY_TZ)

var array<bool> slOpen = array.new<bool>()
var array<bool> slNewSess = array.new<bool>()
var array<bool> slInNy = array.new<bool>()
var array<bool> slSkip = array.new<bool>()
var array<bool> slEvt  = array.new<bool>()

var bool nyOpenSeen = false
var int  lastNyDay  = na
var int  lastSess   = na

array.clear(slOpen)
array.clear(slNewSess)
array.clear(slInNy)
array.clear(slSkip)
array.clear(slEvt)

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        t    = array.get(slT, k)
        mins = hour(t, NY_TZ) * 60 + minute(t, NY_TZ)
        dom  = dayofmonth(t, NY_TZ)
        if na(lastNyDay) or dom != lastNyDay
            nyOpenSeen := false
            lastNyDay  := dom
        // Bounded at both ends. Without the upper bound a Sunday reopen at
        // 18:00 ET counts as an opening: first trade of that New York day.
        isOpen = not nyOpenSeen and mins >= NY_OPEN_MIN and mins < NY_END_MIN
        if isOpen
            nyOpenSeen := true
        sess = sessionDay(t)
        array.push(slNewSess, not na(lastSess) and sess != lastSess)
        lastSess := sess
        array.push(slOpen, isOpen)
        array.push(slInNy, mins >= NY_START_MIN and mins < NY_END_MIN)
        array.push(slSkip, array.includes(excludedDates, sess))
        array.push(slEvt, false)

// ─────────────────────────  SESSION OPENING  ────────────────────────────

// Read off the clock. timeframe.change("D") can run for days without
// reporting a change around a holiday, which freezes every reset hanging
// off it. Each call site keeps its own state.
sessionOpened() =>
    var int  lastDay = na
    var bool seen    = false
    d = dayofmonth(time, NY_TZ)
    if na(lastDay) or d != lastDay
        lastDay := d
        seen    := false
    fire = not seen and hour(time, NY_TZ) * 60 + minute(time, NY_TZ) >= SESS_OPEN_MIN
    if fire
        seen := true
    fire

// The same, for 09:30. Bounded above for the reason the slice detector is:
// a Sunday reopen is the first trade of its New York day and sits well past
// the open.
nyOpened() =>
    var int  lastDay = na
    var bool seen    = false
    d = dayofmonth(time, NY_TZ)
    if na(lastDay) or d != lastDay
        lastDay := d
        seen    := false
    m    = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
    fire = not seen and m >= NY_OPEN_MIN and m < NY_END_MIN
    if fire
        seen := true
    fire

// ══════════════════════════════  V OBJECTS  ═════════════════════════════
// See docs/v-objects.md.

type VObject
    int   t      = na                   // source candle open time
    float top    = na
    float bot    = na
    int   side   = 0                    // +1 long, -1 short
    int   born   = na                   // when its box was drawn
    bool  frozen = false                // touched, and with that done
    int   endT   = na                   // where it stops projecting. While it
                                        // is na the region is still running,
                                        // and the drawing follows
    bool  eaten  = false                // the far edge is gone, so is the region
    bool  active = false                // M only: trimmed and touchable
    float wMin   = na                   // M only: trim window extremes
    float wMax   = na
    int   expire = na                   // M only
    box   bx     = na

// ─────────────────────────────  M OBJECT  ───────────────────────────────

// ───────────────  MAXIMUM DETECTION (runs on the H4 series)  ────────────

h4DailyMax() =>
    var float mVol   = na
    var int   mTime  = na
    var float mOpen  = na
    var float mHigh  = na
    var float mLow   = na
    var float mClose = na
    var int   dayNum = 0                // increments once per session
    var int lastSessDate = na           // the session that just ended, YYYYMMDD
    if sessionOpened() or na(mVol)
        dayNum += 1
        lastSessDate := na(time[1]) ? na : year(time[1], NY_TZ) * 10000 + month(time[1], NY_TZ) * 100 + dayofmonth(time[1], NY_TZ)
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    else if volume > mVol
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    [mTime, mOpen, mHigh, mLow, mClose, mVol, dayNum, lastSessDate]

[wTime, wOpen, wHigh, wLow, wClose, wVol, dayNum, lastSessDate] = request.security(
     syminfo.tickerid, SRC_TF, h4DailyMax(), lookahead = barmerge.lookahead_off)

// ───────────────────────────  STATE  ────────────────────────────────────

var array<VObject> mObjects = array.new<VObject>()
var VObject prov = na                   // winner of the session in progress
var int lastTurnT = na                  // when the session last turned over

// Which M object price entered on each slice, if any. Only the lifecycle
// below is in a position to see it happen, so it publishes it.
var array<VObject> slTouch = array.new<VObject>()

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

isNewSession = dayNum != nz(dayNum[1], 0)
winnerMoved  = wTime != wTime[1]

if not na(wTime)
    objSide = wClose > wOpen ? 1 : wClose < wOpen ? -1 : 0

    if isNewSession
        lastTurnT := time

        // The winner is final only now: while the session ran it could still
        // change hands. Half sessions trade too little for theirs to mean much.
        sessionOk = na(lastSessDate) or not array.includes(excludedDates, lastSessDate)

        if not na(prov)
            if enableM and prov.side != 0 and sessionOk
                prov.expire := prov.t + lifetimeDays * MS_DAY
                prov.bx := box.new(prov.t, prov.top, time, prov.bot,
                     xloc         = xloc.bar_time,
                     border_color = markColor,
                     bgcolor      = color.new(markColor, 85))
                array.push(mObjects, prov)
        prov := VObject.new(t = wTime, top = wHigh, bot = wLow, side = objSide)

    else if winnerMoved and not na(prov)
        prov.t    := wTime
        prov.top  := wHigh
        prov.bot  := wLow
        prov.side := objSide
        prov.wMin := na
        prov.wMax := na

// ──────────────────────────────  TRIM  ──────────────────────────────────
// The New York open is a moment, not a slice. Keyed to the slice that starts
// at 09:30, the trim only landed when that slice was published — five
// minutes later on an M1 chart, fifteen on an M15 — and until then the
// region carried the night's shape and could not be touched at all.
//
// The window is still made of slices and still closes at 09:30, so the range
// a region ends up with does not depend on the chart. Only the moment it is
// applied is read off the bar.

if nyOpened() and not array.includes(excludedDates, sessionDay(time)) and array.size(mObjects) > 0
    for i = array.size(mObjects) - 1 to 0
        obj = array.get(mObjects, i)
        if not obj.active
            // What survives is the part price never visited, on the side the
            // candle came from.
            float newTop = obj.side > 0 ? math.min(obj.top, nz(obj.wMin, obj.top)) : obj.top
            float newBot = obj.side < 0 ? math.max(obj.bot, nz(obj.wMax, obj.bot)) : obj.bot
            if newTop <= newBot
                // Fully absorbed overnight.
                box.delete(obj.bx)
                array.remove(mObjects, i)
            else
                obj.top    := newTop
                obj.bot    := newBot
                obj.active := true

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

array.clear(slTouch)

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        array.push(slTouch, na)
        sT   = array.get(slT, k)
        sH   = array.get(slH, k)
        sL   = array.get(slL, k)
        sIn  = array.get(slInNy, k)
        sNew = array.get(slNewSess, k)
        sSkp = array.get(slSkip, k)

        if not na(prov)
            if sT >= prov.t + TF_MS
                prov.wMin := na(prov.wMin) ? sL : math.min(prov.wMin, sL)
                prov.wMax := na(prov.wMax) ? sH : math.max(prov.wMax, sH)

        if array.size(mObjects) > 0
            for i = array.size(mObjects) - 1 to 0
                obj = array.get(mObjects, i)
                bool drop = false

                // A session the calendar excludes is not one the region is
                // judged on: it neither trims, nor is touched, nor is absorbed
                // there. It reaches the next real session as it was, and goes
                // on being drawn, because it goes on existing.
                if not sSkp
                    // The window closes at the New York open and nowhere else, so
                    // a region that survived a session untouched opens its window
                    // again and is trimmed afresh at the next one. Between the two
                    // it is not touchable, which is what keeps a visit at three in
                    // the morning from settling a box the day had yet to shape.
                    if sNew and not obj.frozen
                        obj.active := false
                        obj.wMin   := na
                        obj.wMax   := na

                    if not obj.active
                        // The window closes at the open of the session the
                        // slice belongs to. Evening slices are before theirs,
                        // which is why the bound is not simply an earlier hour.
                        sMin = hour(sT, NY_TZ) * 60 + minute(sT, NY_TZ)
                        if sMin < NY_OPEN_MIN or sMin >= NY_END_MIN
                            obj.wMin := na(obj.wMin) ? sL : math.min(obj.wMin, sL)
                            obj.wMax := na(obj.wMax) ? sH : math.max(obj.wMax, sH)

                    if not drop and obj.active
                        inside = sH >= obj.bot and sL <= obj.top

                        if obj.frozen
                            // Touched, and with that done. The box ended there
                            // because the region did: it offers itself to no
                            // setup again. It stays on the books only so price
                            // can still be caught absorbing it, which is what
                            // the NY ID object waits on.
                            if sT >= obj.expire
                                drop := true
                        else if inside
                            // The touch, published once, on the same transition
                            // the box draws — so what the chart shows and what
                            // the setup reads are one fact rather than two.
                            //
                            // Published every slice it held instead, a region
                            // wide enough to contain the day went on arming the
                            // setup for as long as it lived, with its box
                            // finished days earlier.
                            //
                            // When price enters two at once the newest claims
                            // the slot, which is why the list is walked from
                            // the end.
                            obj.frozen := true
                            obj.endT   := sT
                            if na(array.get(slTouch, k))
                                array.set(slTouch, k, obj)
                        else if sT >= obj.expire
                            drop := true

                    // The far edge: a bullish region dies on its low, a bearish one
                    // on its high. Absorbed during New York, it fires slEvt.
                    if not drop and obj.active and not obj.eaten
                        if obj.side > 0 ? sL < obj.bot : sH > obj.top
                            obj.eaten := true
                            if sIn
                                array.set(slEvt, k, true)

                if drop
                    box.delete(obj.bx)
                    array.remove(mObjects, i)

// ─────────────────────────────  ID OBJECT  ──────────────────────────────

// ──────────  PRE-NEW-YORK SURVIVOR (runs on the H1 series)  ────────────

h1PreNySurvivor() =>
    var array<int>   cTime = array.new<int>()
    var array<float> cHigh = array.new<float>()
    var array<float> cLow  = array.new<float>()
    var array<float> cVol  = array.new<float>()
    var array<int>   cSide = array.new<int>()
    var array<bool>  cGone = array.new<bool>()
    var bool inWin = false

    if sessionOpened()
        inWin := true
        array.clear(cTime)
        array.clear(cHigh)
        array.clear(cLow)
        array.clear(cVol)
        array.clear(cSide)
        array.clear(cGone)

    nyMin = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
    if inWin and nyMin < 720 and nyMin + ID_TF_MIN > NY_OPEN_MIN
        inWin := false

    if inWin
        if array.size(cTime) > 0
            for i = 0 to array.size(cTime) - 1
                if not array.get(cGone, i)
                    if array.get(cSide, i) > 0 ? low < array.get(cLow, i) : high > array.get(cHigh, i)
                        array.set(cGone, i, true)
        candleSide = close > open ? 1 : close < open ? -1 : 0
        if candleSide != 0
            array.push(cTime, time)
            array.push(cHigh, high)
            array.push(cLow,  low)
            array.push(cVol,  volume)
            array.push(cSide, candleSide)
            array.push(cGone, false)

    int   bTime = na
    float bHigh = na
    float bLow  = na
    float bVol  = na
    int   bSide = 0
    if array.size(cTime) > 0
        for i = 0 to array.size(cTime) - 1
            if not array.get(cGone, i)
                v = array.get(cVol, i)
                if na(bVol) or v > bVol
                    bVol  := v
                    bTime := array.get(cTime, i)
                    bHigh := array.get(cHigh, i)
                    bLow  := array.get(cLow, i)
                    bSide := array.get(cSide, i)
    [bTime, bHigh, bLow, bVol, bSide]

[idSrcTime, idSrcHigh, idSrcLow, idSrcVol, idSrcSide] = request.security(
     syminfo.tickerid, ID_TF, h1PreNySurvivor(), lookahead = barmerge.lookahead_off)

// ───────────────────────────  STATE  ────────────────────────────────────

var VObject idObj = na                  // the one of this session

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

if isNewSession
    if not na(idObj)
        box.delete(idObj.bx)
    idObj := na

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        sT  = array.get(slT, k)
        sH  = array.get(slH, k)
        sL  = array.get(slL, k)
        sIn = array.get(slInNy, k)

        if enableId and array.get(slOpen, k) and not array.get(slSkip, k) and not na(idSrcTime)
            // Whatever stands here goes first: an orphaned box can never be
            // reached again and would sit on the chart for good.
            if not na(idObj)
                box.delete(idObj.bx)
            idObj := VObject.new(t = idSrcTime, top = idSrcHigh,
                 bot = idSrcLow, side = idSrcSide, born = sT)
            idObj.bx := box.new(idSrcTime, idSrcHigh, sT, idSrcLow,
                 xloc         = xloc.bar_time,
                 border_color = idColor,
                 bgcolor      = color.new(idColor, 85))

        if not na(idObj) and not idObj.frozen
            if sH >= idObj.bot and sL <= idObj.top
                idObj.frozen := true
                idObj.endT   := sT

        if not na(idObj) and not idObj.eaten
            if idObj.side > 0 ? sL < idObj.bot : sH > idObj.top
                idObj.eaten := true
                if sIn
                    array.set(slEvt, k, true)

// ───────────────────────────  NY ID OBJECT  ─────────────────────────────
// Redrawn on an absorption event, and only then. See docs/v-objects.md.

// ───────────────────────────  STATE  ────────────────────────────────────

var VObject nyObj = na                  // the one of this session, as drawn

// The H1 candle in progress, accumulated from slices: request.security
// cannot hand back an unclosed candle on history, and an unclosed candle
// is exactly what may have to be picked.
var int   curT = na
var float curO = na
var float curH = na
var float curL = na
var float curC = na
var float curV = na

var array<int>   nyT    = array.new<int>()
var array<float> nyH    = array.new<float>()
var array<float> nyL    = array.new<float>()
var array<float> nyV    = array.new<float>()
var array<int>   nySd   = array.new<int>()
var array<bool>  nyGone = array.new<bool>()

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

if isNewSession
    if not na(nyObj)
        box.delete(nyObj.bx)
    nyObj := na
    curT  := na                         // so the candle straddling the
    curO  := na                         // turnover is not filed under the
    curH  := na                         // session that is starting
    curL  := na
    curC  := na
    curV  := na
    array.clear(nyT)
    array.clear(nyH)
    array.clear(nyL)
    array.clear(nyV)
    array.clear(nySd)
    array.clear(nyGone)

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        sT = array.get(slT, k)
        sO = array.get(slO, k)
        sH = array.get(slH, k)
        sL = array.get(slL, k)
        sC = array.get(slC, k)
        sV = array.get(slV, k)

        if na(curT) or math.floor(sT / ID_TF_MS) != math.floor(curT / ID_TF_MS)
            if not na(curT)
                endedSide  = curC > curO ? 1 : curC < curO ? -1 : 0
                endedNyMin = hour(curT, NY_TZ) * 60 + minute(curT, NY_TZ)
                if endedSide != 0 and endedNyMin >= NY_START_MIN and endedNyMin < NY_END_MIN
                    array.push(nyT,    curT)
                    array.push(nyH,    curH)
                    array.push(nyL,    curL)
                    array.push(nyV,    curV)
                    array.push(nySd,   endedSide)
                    array.push(nyGone, false)
            curT := sT - sT % ID_TF_MS
            curO := sO
            curH := sH
            curL := sL
            curC := sC
            curV := nz(sV)
        else
            curH := math.max(curH, sH)
            curL := math.min(curL, sL)
            curC := sC
            curV := curV + nz(sV)

        if array.size(nyT) > 0
            for i = 0 to array.size(nyT) - 1
                if not array.get(nyGone, i) and sT >= array.get(nyT, i) + ID_TF_MS
                    if array.get(nySd, i) > 0 ? sL < array.get(nyL, i) : sH > array.get(nyH, i)
                        array.set(nyGone, i, true)

        int   bestT = na
        float bestH = na
        float bestL = na
        float bestV = na
        int   bestS = 0
        if array.size(nyT) > 0
            for i = 0 to array.size(nyT) - 1
                if not array.get(nyGone, i)
                    v = array.get(nyV, i)
                    if na(bestV) or v > bestV
                        bestV := v
                        bestT := array.get(nyT, i)
                        bestH := array.get(nyH, i)
                        bestL := array.get(nyL, i)
                        bestS := array.get(nySd, i)

        curNyMin = na(curT) ? na : hour(curT, NY_TZ) * 60 + minute(curT, NY_TZ)
        curSide  = na(curT) ? 0 : curC > curO ? 1 : curC < curO ? -1 : 0
        if not na(curNyMin) and curNyMin >= NY_START_MIN and curNyMin < NY_END_MIN and curSide != 0
            if na(bestV) or curV > bestV
                bestV := curV
                bestT := curT
                bestH := curH
                bestL := curL
                bestS := curSide

        // A bigger candle closing between events does not take the place on
        // its own: it takes it at the next event.
        if enableNyId and array.get(slEvt, k) and (na(nyObj) or not nyObj.eaten) and not array.get(slSkip, k) and not na(bestT)
            if not na(nyObj)
                box.delete(nyObj.bx)
            nyObj := VObject.new(t = bestT, top = bestH, bot = bestL,
                 side = bestS, born = sT)
            nyObj.bx := box.new(bestT, bestH, sT, bestL,
                 xloc         = xloc.bar_time,
                 border_color = nyIdColor,
                 bgcolor      = color.new(nyIdColor, 85))

        if not na(nyObj) and not nyObj.eaten
            if nyObj.side > 0 ? sL < nyObj.bot : sH > nyObj.top
                nyObj.eaten := true
                nyObj.endT  := sT

// ────────────────────────────  DRAWING  ─────────────────────────────────
// The only place a box is given a shape. Every V object is painted from its
// own state, on every bar, so the chart cannot say anything the object does
// not: the range is the range, and the box ends where the region ends.
//
// Geometry used to be written wherever a lifecycle happened to be — at the
// trim, at the touch, at an absorption, on an excluded session — half a
// dozen places that each had to remember to keep the drawing current. Miss
// one and the chart and the model become two accounts of the same fact.
// They did, and telling which was wrong took longer than either bug.

paint(VObject o) =>
    if not na(o) and not na(o.bx)
        box.set_lefttop(o.bx, o.t, o.top)
        box.set_rightbottom(o.bx, na(o.endT) ? time : o.endT, o.bot)

if array.size(mObjects) > 0
    for i = 0 to array.size(mObjects) - 1
        paint(array.get(mObjects, i))

paint(idObj)
paint(nyObj)

// ════════════════════════════  LATENT OBJECTS  ══════════════════════════
// See docs/latent-objects.md.
//
// One block per class, then one machine that knows none of them by name.
// A class is a row of parameters, so a fourth is a block and a row, not a
// path through the logic.

// ─────────────────────────────  FAMILY  ─────────────────────────────────

G_L = "Objects · Latent objects"

enableLatent = input.bool(true, "Enable latent objects", group = G_L)
qualifyAt    = input.int(3, "Qualifies at (daily candles)", minval = 1, group = G_L,
     tooltip = "How long a high or a low must survive unbroken to count as a level at all. Below this it is just a high. Where each class ends is declared by the class itself, and the next one begins there.")
showLevels   = input.bool(false, "Draw qualified levels", group = G_L,
     tooltip = "The levels that have qualified and are still waiting for a break. Off by default: there are many more of them than there are objects, and Pine draws a bounded number of shapes.")
keepSpent    = input.int(50, "Retested objects kept", minval = 0, group = G_L,
     tooltip = "A retested object is finished, and stays on the chart to be read. Past this many, the oldest is dropped. The diagnostics report what is alive against what is drawn.")

// ───────────────────────────────  SWI  ──────────────────────────────────

G_SWI = "Objects · Latent objects · Swi"

swiDies  = input.int(7, "Dies at (daily candles)", minval = 1, group = G_SWI)
swiLat   = input.int(1, "Latency (daily candles)", minval = 1, group = G_SWI)
swiZone  = input.float(300, "Zone (points)", minval = 0, group = G_SWI)
swiDraw  = input.bool(true, "Draw", group = G_SWI)
swiColor = input.color(color.new(color.teal, 0), "Color", group = G_SWI)

// ───────────────────────────────  POS  ──────────────────────────────────

G_POS = "Objects · Latent objects · Pos"

posDies  = input.int(21, "Dies at (daily candles)", minval = 1, group = G_POS)
posLat   = input.int(1, "Latency (daily candles)", minval = 1, group = G_POS)
posZone  = input.float(300, "Zone (points)", minval = 0, group = G_POS)
posDraw  = input.bool(true, "Draw", group = G_POS)
posColor = input.color(color.new(color.green, 0), "Color", group = G_POS)

// ───────────────────────────────  INV  ──────────────────────────────────

G_INV = "Objects · Latent objects · Inv"

invDies  = input.int(1021, "Dies at (daily candles)", minval = 1, group = G_INV,
     tooltip = "The end of the last band, and so the age at which a level that was never broken is given up on.")
invLat   = input.int(21, "Latency (daily candles)", minval = 1, group = G_INV)
invZone  = input.float(500, "Zone (points)", minval = 0, group = G_INV)
invDraw  = input.bool(true, "Draw", group = G_INV)
invColor = input.color(color.new(color.maroon, 0), "Color", group = G_INV)

// ──────────────────────────  THE CLASSES  ───────────────────────────────
// The blocks above are read from here and nowhere else. Each class declares
// where it ends and the next one begins there, so a boundary is one number
// and no two of them can disagree. Ascending order is what makes the bands
// consecutive.

var array<string> clsLabel   = array.from("Swi", "Pos", "Inv")
var array<int>    clsDiesAt  = array.from(swiDies, posDies, invDies)
var array<int>    clsLatency = array.from(swiLat, posLat, invLat)
var array<float>  clsZonePts = array.from(swiZone, posZone, invZone)
var array<bool>   clsDraw    = array.from(swiDraw, posDraw, invDraw)
var array<color>  clsTint    = array.from(swiColor, posColor, invColor)

// The class is not stored anywhere. It is the band an age falls in, read
// where it is needed, so nothing can disagree with its own age.
clsOf(int age) =>
    int c = -1
    if age >= qualifyAt
        for k = 0 to array.size(clsDiesAt) - 1
            if c < 0 and age < array.get(clsDiesAt, k)
                c := k
    c

// Past the last band there is nothing left to be promoted to.
lastDies() => array.get(clsDiesAt, array.size(clsDiesAt) - 1)

clsName(int c) => c < 0 ? "—" : array.get(clsLabel, c)

// ──────────────────────────────  TYPES  ─────────────────────────────────

type Level
    float px    = na                    // the price that held
    int   side  = 0                     // +1 left by a high, -1 by a low
    int   srcT  = na                    // when the candle that left it closed
    float inner = na                    // that candle's far side, where a
                                        // zone measured from here stops
    int   age   = 0                     // daily candles survived unbroken
    line  ln    = na

type Latent
    float top    = na
    float bot    = na
    int   side   = 0
    int   cls    = -1
    int   srcT   = na                   // the candle that left the level
    int   brokeT = na                   // where the wait began
    int   left   = 0                    // daily candles still owed to the retest
    int   endT   = na                   // where it stops projecting
    bool  hit    = false
    box   bx     = na

var array<Level>  levels  = array.new<Level>()
var array<Latent> latents = array.new<Latent>()

// Two candles can leave the same extreme, and the second would otherwise
// start a level the first is already holding.
hasLevel(float px, int side) =>
    bool found = false
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            if lv.side == side and math.abs(lv.px - px) < syminfo.mintick / 2
                found := true
                break
    found

// ───────────────────────────  THE DAILY FEED  ───────────────────────────
// The previous bar of the higher timeframe, which is the last one closed.
// Read any other way it is still forming, and a level would break on a
// candle that has not finished happening.

[dHigh, dLow, dClose, dTime] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)

newDaily = not na(dTime) and (na(dTime[1]) or dTime != dTime[1])

// ─────────────────────────────  RETEST  ─────────────────────────────────
// On the bar, not on the daily candle: activation is an event, and what
// reads it later will want when, not merely whether. Run before the daily
// step so an object is never tested against the bar it was born on.

if enableLatent and array.size(latents) > 0
    for i = 0 to array.size(latents) - 1
        o = array.get(latents, i)
        if not o.hit and high >= o.bot and low <= o.top
            o.hit  := true
            o.endT := time

// ───────────────────────────  THE DAILY STEP  ───────────────────────────

if enableLatent and newDaily
    // Latency, spent only by objects that were already waiting.
    if array.size(latents) > 0
        for i = array.size(latents) - 1 to 0
            o = array.get(latents, i)
            if not o.hit
                o.left := o.left - 1
                if o.left <= 0
                    box.delete(o.bx)
                    array.remove(latents, i)

    // The levels, against the candle that just closed.
    if array.size(levels) > 0
        for i = array.size(levels) - 1 to 0
            lv = array.get(levels, i)
            bool broke = lv.side > 0 ? dClose > lv.px : dClose < lv.px
            bool wick  = lv.side > 0 ? dHigh > lv.px : dLow < lv.px
            bool drop  = false

            if broke
                int c = clsOf(lv.age)
                if c >= 0
                    float n   = array.get(clsZonePts, c)
                    float top = lv.side > 0 ? lv.px : math.min(lv.px + n, lv.inner)
                    float bot = lv.side > 0 ? math.max(lv.px - n, lv.inner) : lv.px
                    array.push(latents, Latent.new(top = top, bot = bot,
                         side = lv.side, cls = c, srcT = lv.srcT,
                         brokeT = dTime, left = array.get(clsLatency, c)))
                drop := true
            else if wick
                // Price went further than what held, so what held is no
                // longer the level. The extreme it reached is, and this
                // same candle is about to leave it below.
                drop := true
            else
                lv.age := lv.age + 1
                if lv.age >= lastDies()
                    drop := true

            if drop
                line.delete(lv.ln)
                array.remove(levels, i)

    // What the candle leaves behind.
    if not hasLevel(dHigh, 1)
        array.push(levels, Level.new(px = dHigh, side = 1, srcT = dTime, inner = dLow))
    if not hasLevel(dLow, -1)
        array.push(levels, Level.new(px = dLow, side = -1, srcT = dTime, inner = dHigh))

    // A retested object is finished. It is kept to be read, not forever.
    int spent = 0
    if array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            if array.get(latents, i).hit
                spent := spent + 1
    while spent > keepSpent and array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            if array.get(latents, i).hit
                box.delete(array.get(latents, i).bx)
                array.remove(latents, i)
                break
        spent := spent - 1

// ────────────────────────────  DRAWING  ─────────────────────────────────
// Same rule as the V objects: every shape is set from the state that owns
// it, in one place, and never written where a lifecycle happens. The inputs
// decide what is drawn and the diagnostics report what is not, so what the
// chart leaves out is a choice and never an accident.
//
// Unlike the V objects, this runs on the last bar rather than on every one.
// There are five V objects at most; there are hundreds of levels, and a
// pass over all of them on every M1 bar of a year of history is time the
// script does not have. Drawings persist once made, so the last bar is the
// only pass whose result is on the screen — in replay too, where the last
// bar is wherever the replay stands.

var int drawnLevels = 0
var int drawnLatent = 0

if barstate.islast
    drawnLevels := 0
    drawnLatent := 0

    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            int  c    = clsOf(lv.age)
            bool want = showLevels and c >= 0 and array.get(clsDraw, c)
            if want and na(lv.ln)
                lv.ln := line.new(lv.srcT, lv.px, time, lv.px, xloc = xloc.bar_time,
                     color = array.get(clsTint, c), width = 1)
            if not want and not na(lv.ln)
                line.delete(lv.ln)
                lv.ln := na
            if not na(lv.ln)
                line.set_xy1(lv.ln, lv.srcT, lv.px)
                line.set_xy2(lv.ln, time, lv.px)
                line.set_color(lv.ln, array.get(clsTint, c))
                drawnLevels := drawnLevels + 1

    if array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            o = array.get(latents, i)
            bool want = array.get(clsDraw, o.cls)
            if want and na(o.bx)
                o.bx := box.new(o.srcT, o.top, time, o.bot, xloc = xloc.bar_time,
                     border_color = array.get(clsTint, o.cls),
                     bgcolor      = color.new(array.get(clsTint, o.cls), 85))
            if not want and not na(o.bx)
                box.delete(o.bx)
                o.bx := na
            if not na(o.bx)
                box.set_lefttop(o.bx, o.srcT, o.top)
                box.set_rightbottom(o.bx, na(o.endT) ? time : o.endT, o.bot)
                drawnLatent := drawnLatent + 1

// ══════════════════════════  MARKET STRUCTURE  ══════════════════════════
// See docs/market-structure.md.

STRUCT_TF = "1"

G_STRUCT = "Objects · Pattern objects"

enableStruct   = input.bool(true, "Enable market structure", group = G_STRUCT,
     tooltip = "Off publishes nothing: no levels, no direction, no change of character for anything downstream to read.")
showStructPath = input.bool(true,  "Draw the path between points", group = G_STRUCT)
showStructTags = input.bool(false, "Label the points", group = G_STRUCT)
structUpColor  = input.color(color.new(color.teal, 0),   "Up",   group = G_STRUCT)
structDnColor  = input.color(color.new(color.maroon, 0), "Down", group = G_STRUCT)

// ───────────────────────────  THE MACHINE  ──────────────────────────────
// Candidates are local extremes, one candle either side. What thins them
// out is a level, never a size: going up, a candidate high counts only if
// it exceeds the last structural high, and the interval's lowest candidate
// low comes with it. Going down, the mirror. A qualifying candidate
// therefore brings in two points at once, handed back in order.

marketStructure() =>
    var int   phase     = 1             // +1 going up, -1 going down
    var float lastHigh  = na            // the two levels
    var float lastLow   = na
    var float pendHigh  = na            // best candidate since the last
    var int   pendHighT = na            // structural point of the other kind
    var float pendLow   = na
    var int   pendLowT  = na
    var int   ptCount   = 0             // points registered so far
    var int   chCount   = 0             // changes of character so far
    var int   chDir     = 0
    var int   chT       = na

    float aP = na                       // the points this candle produced
    int   aT = na
    bool  aH = false
    float bP = na
    int   bT = na
    bool  bH = false

    cLow  = low[1]  <  low[0]  and low[1]  <= low[2]
    cHigh = high[1] >  high[0] and high[1] >= high[2]

    if na(lastHigh)
        lastHigh := high
        lastLow  := low

    if cLow
        if na(pendLow) or low[1] < pendLow
            pendLow  := low[1]
            pendLowT := time[1]
    if cHigh
        if na(pendHigh) or high[1] > pendHigh
            pendHigh  := high[1]
            pendHighT := time[1]

    bool takeHigh = false
    bool takeLow  = false

    // A change of character is price reaching through a level. A wick is
    // enough: requiring a close was tried and read the structure worse.
    if phase == 1
        if cHigh and high[1] > lastHigh
            takeHigh := true
        if low < lastLow
            phase   := -1
            chCount += 1
            chDir   := -1
            chT     := time
    else
        if cLow and low[1] < lastLow
            takeLow := true
        if high > lastHigh
            phase   := 1
            chCount += 1
            chDir   := 1
            chT     := time

    if takeHigh
        if not na(pendLow)
            aP      := pendLow
            aT      := pendLowT
            aH      := false
            lastLow := pendLow
            ptCount += 1
        bP       := high[1]
        bT       := time[1]
        bH       := true
        lastHigh := high[1]
        ptCount  += 1
        pendLow  := na

    if takeLow
        if not na(pendHigh)
            aP       := pendHigh
            aT       := pendHighT
            aH       := true
            lastHigh := pendHigh
            ptCount  += 1
        bP       := low[1]
        bT       := time[1]
        bH       := false
        lastLow  := low[1]
        ptCount  += 1
        pendHigh := na

    [phase, lastHigh, lastLow, ptCount, aP, aT, aH, bP, bT, bH, chCount, chDir, chT]

[structPhase, structHigh, structLow, structPts,
     sAP, sAT, sAH, sBP, sBT, sBH,
     structChCount, structChDir, structChT] =
     request.security(syminfo.tickerid, STRUCT_TF, marketStructure(),
     lookahead = barmerge.lookahead_off)

// What the rest of the script reads. Disabled, the model publishes nothing.
structOn    = enableStruct
structChoch = structOn and structChCount != nz(structChCount[1], 0)
structNewPt = structOn and structPts != nz(structPts[1], 0)
structColor = structPhase > 0 ? structUpColor : structDnColor

// ════════════════════════════════  SETUP  ═══════════════════════════════
// Publishes the V object in play, not a verdict. See docs/setup.md.

var VObject setupObj  = na              // the region in play, or none
string      setupName = ""              // which setup put it there
bool        setupTook = false           // it took one on this bar

// ─────────────────────────  M TOUCH  ────────────────────────────────────

G_SETUPS = "Setups"

enableMSetup = input.bool(true, "Enable the M touch setup", group = G_SETUPS,
     tooltip = "Needs M objects to be enabled. With those off this setup can never take a region, and the diagnostics say so.")

mSetupReady = enableMSetup and enableM   // what it needs from the model

// ─────────────────────────  TRADING HOURS  ──────────────────────────────
// Read by this setup and by the position manager, so it is declared once
// and carries the position manager's group. It sits here rather than
// earlier only so the Portfolio section does not open above the model in
// the settings dialog.

G_PM = "Portfolio · Position management"

tradingHours = input.session("0930-1700", "Trading hours · New York time", group = G_PM,
     tooltip = "New York time, not the chart's timezone. The defaults are what the model already calls New York — set them to the hours you actually trade.")

// The session string reads "0930-1700": fixed offsets, whatever day mask
// may follow them.
hhmm(string s) => int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 2, 4)))

tradingFrom = hhmm(str.substring(tradingHours, 0, 4))
tradingTo   = hhmm(str.substring(tradingHours, 5, 9))

if isNewSession
    setupObj := na

// Let go of a region that no longer exists. Never on a target: the setup
// cannot see a position.
//
// Read on the bar, not on the grid. A slice is published once every five
// minutes, so on an M1 chart the region would stay in play for four more
// after price took the edge it lives off, and a change of character inside
// that window would trade something already gone.
if not na(setupObj)
    gone = setupObj.side > 0 ? low < setupObj.bot : high > setupObj.top
    if setupObj.eaten or gone or time >= setupObj.expire
        setupObj := na

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        if mSetupReady
            // An absorbed region is never taken. Price on its way out of one
            // is inside it, so the slice that kills a region also reports a
            // touch on it.
            VObject hit = array.get(slTouch, k)
            if not na(hit) and not hit.eaten and not array.get(slSkip, k)
                sT   = array.get(slT, k)
                mins = hour(sT, NY_TZ) * 60 + minute(sT, NY_TZ)
                if mins >= tradingFrom and mins < tradingTo
                    if na(setupObj) or setupObj.t != hit.t
                        setupTook := true
                    setupObj := hit

if not na(setupObj)
    setupName := "M touch"

// ════════════════════════════════  SIGNAL  ══════════════════════════════
// A change of character qualified by the setup: there has to be a region
// in play, and the turn has to agree with its side. See docs/signal.md.

signalFired = structChoch and not na(setupObj) and structChDir == setupObj.side
signalDir   = structChDir

// ═════════════════════════════  DIAGNOSTICS  ════════════════════════════
// Shared, and appended to by the portfolio. Row numbers are fixed rather
// than running, so a section can add rows without knowing what another
// did; a row nobody fills is never drawn. See docs/diagnostics.md.

stamp(int t) => na(t) ? "—" : str.format_time(t, "yyyy-MM-dd HH:mm", NY_TZ)
sided(int sd) => sd > 0 ? "long" : sd < 0 ? "short" : "—"
// Pine's integer division yields a float, so the hour is floored rather
// than left to a format string to round.
clock(int m) =>
    h  = math.floor(m / 60)
    mm = m % 60
    (h < 10 ? "0" : "") + str.tostring(h) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm)

var table diag = table.new(position.top_right, 2, 36, border_width = 1,
     frame_width = 1, frame_color = color.gray)

diagRow(int r, string k, string v) =>
    table.cell(diag, 0, r, k, text_color = color.gray, text_size = size.tiny,
         text_halign = text.align_right, bgcolor = color.new(color.black, 85))
    table.cell(diag, 1, r, v, text_color = color.white, text_size = size.tiny,
         text_halign = text.align_left, bgcolor = color.new(color.black, 85))

if showDiag and barstate.islast
    // Where the M objects actually are. A count says two and the chart shows
    // one, and there is no way to tell which region a setup took.
    string mList = ""
    if array.size(mObjects) > 0
        for i = 0 to array.size(mObjects) - 1
            o = array.get(mObjects, i)
            mList := mList + (i > 0 ? "    " : "") + str.tostring(o.bot, format.mintick) + "–" + str.tostring(o.top, format.mintick) + " " + sided(o.side) + (not o.active ? " trimming" : o.frozen ? " touched" : " live") + (o.eaten ? " · absorbed" : "")

    diagRow(0,  "chart",         timeframe.period + (coarse ? "  split" : "  bucketed"))
    diagRow(1,  "slices / bar",  str.tostring(array.size(slT)))
    diagRow(2,  "bar",           stamp(time) + "   session " + str.tostring(sessionDay(time)) + (array.includes(excludedDates, sessionDay(time)) ? " · SKIPPED" : "") + "   " + str.tostring(array.size(excludedDates)) + " listed")
    diagRow(3,  "H4 dayNum",     str.tostring(dayNum) + (isNewSession ? "   turning" : ""))
    diagRow(4,  "H4 sess date",  na(lastSessDate) ? "—" : str.tostring(lastSessDate))
    diagRow(5,  "last turnover", stamp(lastTurnT))
    diagRow(6,  "M alive",       str.tostring(array.size(mObjects)) + (mList == "" ? "" : "   " + mList))
    diagRow(7,  "ID source",     stamp(idSrcTime) + "  " + sided(idSrcSide))
    diagRow(8,  "ID born",       na(idObj) ? "—" : stamp(idObj.born))
    diagRow(9,  "ID range",      na(idObj) ? "no box" : str.tostring(idObj.bot, format.mintick) + " – " + str.tostring(idObj.top, format.mintick) + "  " + sided(idObj.side))
    diagRow(10, "ID state",      na(idObj) ? "—" : (idObj.frozen ? "touched" : "live") + (idObj.eaten ? " · absorbed" : ""))
    diagRow(11, "structure",     not structOn ? "off" : (structPhase > 0 ? "up" : "down"))
    diagRow(12, "struct levels", not structOn ? "—" : str.tostring(structLow, format.mintick) + " – " + str.tostring(structHigh, format.mintick) + "   " + str.tostring(structPts) + " pts")
    diagRow(13, "last CHoCH",    not structOn ? "—" : stamp(structChT) + "  " + (structChDir > 0 ? "to up" : structChDir < 0 ? "to down" : "—") + "   ×" + str.tostring(structChCount))
    diagRow(14, "setup",         not mSetupReady ? "M touch · needs M objects" : na(setupObj) ? "M touch · idle" : "M touch · holding " + str.tostring(setupObj.bot, format.mintick) + " – " + str.tostring(setupObj.top, format.mintick))
    diagRow(15, "signal",        not signalFired ? "—" : signalDir > 0 ? "fired up" : "fired down")

    // Latent objects: what the model holds against what the chart shows.
    // Counted by walking the classes, so a class added is a class reported.
    string lvlList = ""
    for k = 0 to array.size(clsLabel) - 1
        int n = 0
        if array.size(levels) > 0
            for i = 0 to array.size(levels) - 1
                if clsOf(array.get(levels, i).age) == k
                    n := n + 1
        lvlList := lvlList + (k > 0 ? " · " : "") + array.get(clsLabel, k) + " " + str.tostring(n)
    int latWait = 0
    int latHit  = 0
    if array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            if array.get(latents, i).hit
                latHit := latHit + 1
            else
                latWait := latWait + 1

    diagRow(30, "daily feed",  stamp(dTime))
    diagRow(31, "levels",      not enableLatent ? "off" : lvlList + "   " + str.tostring(array.size(levels)) + " held   " + str.tostring(drawnLevels) + " drawn")
    diagRow(32, "latent",      not enableLatent ? "off" : str.tostring(latWait) + " waiting · " + str.tostring(latHit) + " retested   " + str.tostring(drawnLatent) + " drawn")

// ════════════════════════════════  OUTPUT  ══════════════════════════════
// What the model draws, in both scripts: a strategy that cannot show the
// structure it trades is not worth watching.

// ──────────────────────  MARKET STRUCTURE  ──────────────────────────────
// Two points can land on the same bar, so they are consumed in order, and
// each is named against the last of its own kind, not against its
// neighbour.

var float sPrevP  = na
var int   sPrevT  = na
var float sPrevHi = na
var float sPrevLo = na

if structNewPt
    for slot = 0 to 1
        float p = slot == 0 ? sAP : sBP
        int   t = slot == 0 ? sAT : sBT
        bool  h = slot == 0 ? sAH : sBH
        if not na(t)
            if showStructPath and not na(sPrevT)
                line.new(sPrevT, sPrevP, t, p, xloc = xloc.bar_time,
                     color = h ? structUpColor : structDnColor, width = 1)
            if showStructTags
                string tag = h ? (na(sPrevHi) ? "H" : p > sPrevHi ? "HH" : "LH")
                     : (na(sPrevLo) ? "L" : p < sPrevLo ? "LL" : "HL")
                label.new(t, p, tag, xloc = xloc.bar_time,
                     style     = h ? label.style_label_down : label.style_label_up,
                     color     = color.new(h ? structDnColor : structUpColor, 20),
                     textcolor = color.white, size = size.tiny)
            if h
                sPrevHi := p
            else
                sPrevLo := p
            sPrevP := p
            sPrevT := t

plot(structOn ? structHigh : na, "Structure high", color = color.new(structDnColor, 40),
     style = plot.style_stepline, linewidth = 1)
plot(structOn ? structLow : na,  "Structure low",  color = color.new(structUpColor, 40),
     style = plot.style_stepline, linewidth = 1)

// Two calls, not one: plotshape's location argument has to be const.
plotshape(structChoch and structChDir > 0, "CHoCH up",
     shape.triangleup, location.belowbar, color = structUpColor, size = size.small)
plotshape(structChoch and structChDir < 0, "CHoCH down",
     shape.triangledown, location.abovebar, color = structDnColor, size = size.small)

// ──────────────────────────────  SETUP  ─────────────────────────────────

plotshape(setupTook, "Setup took a region", shape.square, location.top,
     color = color.new(color.yellow, 20), size = size.tiny)

// ─────────────────────────────  WARNINGS  ───────────────────────────────

if barstate.islast
    if warnGrid and not coarse and 300 % timeframe.in_seconds() != 0
        label.new(bar_index, high, "Chart timeframe (" + timeframe.period + ") does not divide the 5-minute grid\nSlices will not line up with other timeframes",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)
    if na(wVol)
        label.new(bar_index, high, "This symbol does not report volume on H4",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)

// ═══════════════════════════════  STRATEGY  ═════════════════════════════
// An intention, not an order. See docs/strategy.md.

G_STRATEGIES = "Strategies"

TGT_OBJECT = "Object"
TGT_R      = "R multiple"

targetMode = input.string(TGT_OBJECT, "Target", options = [TGT_OBJECT, TGT_R],
     group = G_STRATEGIES,
     tooltip = "Object exits at the day's other extreme: a long at the dearest quote of the day, a short at the cheapest. R multiple exits at a fixed multiple of the distance to the loss.")
targetR    = input.float(2.0, "R multiple", minval = 0.1, step = 0.1, group = G_STRATEGIES,
     tooltip = "Idle under the Object target. R is the distance from the execution to the loss.")

// ─────────────────────────  THE DAY'S EXTREMES  ─────────────────────────
// The dearest and cheapest quotes of the session, read straight off the
// chart against a clock of their own.
//
// Not off isNewSession: that comes from the H4 feed, which reports a
// turnover at the close of the candle that opened the session — four hours
// late. The extremes then belonged to a day running 22:00 to 22:00, which
// is nobody's day.
//
// Not off the grid either: a five-minute slice is only published when its
// bucket closes, so on an M1 chart the extremes would trail the signal by
// up to four minutes and miss a low price just made.

var int   daySess = na
var float dayHigh = na
var float dayLow  = na

barSess = sessionDay(time)
if na(daySess) or barSess != daySess
    daySess := barSess
    dayHigh := high
    dayLow  := low
else
    dayHigh := math.max(dayHigh, high)
    dayLow  := math.min(dayLow,  low)

// ══════════════════════════════  M REVERSION  ═══════════════════════════
// The only strategy so far. Three components, one block each, in the order
// they decide: where in, where the idea is wrong, where it is done. A block
// may veto what the one above it published, and nothing reaches back up.

// ───────────────────────────  EXECUTION  ────────────────────────────────
// At market, on the change of character.

int   tradeDir  = 0                     // +1 long, -1 short, 0 nothing
float tradeExec = na

if signalFired
    tradeDir  := signalDir
    tradeExec := close

// ─────────────────────────────  LOSS  ───────────────────────────────────
// The extreme the trade is exposed to: a long is wrong at the cheapest
// quote of the day, a short at the dearest.
//
// It can only sit on the wrong side of the execution by being the
// execution — price making the low as the signal fires. No distance, no
// trade, and the execution is withdrawn.

float tradeLoss = na

if tradeDir != 0
    lvl = tradeDir > 0 ? dayLow : dayHigh
    if not na(lvl) and (tradeDir > 0 ? lvl < tradeExec : lvl > tradeExec)
        tradeLoss := lvl
    else
        tradeDir  := 0
        tradeExec := na

// ────────────────────────────  TARGET  ──────────────────────────────────
// Two rules, chosen by input. The exit by time is not here: it is always
// on, it is about holding a position, and the strategy cannot see one. It
// lives in position management.
//
// An object target that is not ahead of the execution leaves no target at
// all, and the position then ends on the loss or on the hours.

float  tradeTarget = na
string tradeFrom   = ""                 // which rule set it

if tradeDir != 0
    if targetMode == TGT_R
        tradeTarget := tradeExec + tradeDir * targetR * math.abs(tradeExec - tradeLoss)
        tradeFrom   := str.tostring(targetR) + "R"
    else
        aim = tradeDir > 0 ? dayHigh : dayLow
        if not na(aim) and (tradeDir > 0 ? aim > tradeExec : aim < tradeExec)
            tradeTarget := aim
            tradeFrom   := tradeDir > 0 ? "day high" : "day low"

// ────────────────────────  DIAGNOSTICS  ─────────────────────────────────

if showDiag and barstate.islast
    diagRow(16, "day range",  na(dayLow) ? "—" : str.tostring(dayLow, format.mintick) + " – " + str.tostring(dayHigh, format.mintick))
    diagRow(17, "intention",  tradeDir == 0 ? "—" : (tradeDir > 0 ? "long" : "short") + " @ " + str.tostring(tradeExec, format.mintick))
    diagRow(18, "loss",       na(tradeLoss) ? "—" : str.tostring(tradeLoss, format.mintick) + "   " + str.tostring(math.abs(tradeExec - tradeLoss), format.mintick) + " away")
    diagRow(19, "target",     na(tradeTarget) ? (tradeDir == 0 ? "—" : "none · time exit only") : str.tostring(tradeTarget, format.mintick) + "   " + tradeFrom)

// ═══════════════════════════════  PORTFOLIO  ════════════════════════════
// How much, and whether at all. Strategy only: an indicator has no book.
// Two blocks that never reach into each other. See docs/portfolio.md.

// ────────────────────────  RISK MANAGEMENT  ─────────────────────────────
// Shown one trade and nothing else: the stop distance and a budget.

G_RISK = "Portfolio · Risk management"

RISK_PCT   = "Percent of equity"
RISK_FIXED = "Fixed amount"
EQ_CURRENT = "Current equity"
EQ_INITIAL = "Initial capital"

riskMode   = input.string(RISK_PCT, "Risk per position", options = [RISK_PCT, RISK_FIXED],
     group = G_RISK,
     tooltip = "How the budget for one position is expressed. The amount below is read in whichever unit this names.")
riskQty    = input.float(1.0, "Amount", minval = 0.0, step = 0.1, group = G_RISK,
     tooltip = "A percentage under Percent of equity, an amount of account currency under Fixed amount.")
equityMode = input.string(EQ_CURRENT, "Measured against", options = [EQ_CURRENT, EQ_INITIAL],
     group = G_RISK,
     tooltip = "Current equity compounds: the position grows after a win and shrinks after a loss. Initial capital keeps the risk flat whatever the account has done since. Idle under Fixed amount.")
maxContracts = input.int(10, "Contracts ceiling", minval = 1, group = G_RISK,
     tooltip = "A hard maximum, applied after the budget has spoken. It never raises a size, only caps one.")

riskEquity = equityMode == EQ_INITIAL ? strategy.initial_capital : strategy.equity

riskBudget = riskMode == RISK_FIXED ? riskQty : riskEquity * riskQty / 100.0

// A point of price is worth syminfo.pointvalue, so nothing here is
// specific to one symbol.
riskPerContract = na(tradeExec) or na(tradeLoss) ? na : math.abs(tradeExec - tradeLoss) * syminfo.pointvalue

// Always down. Rounding up would spend more than the budget just declared,
// and a budget short of one contract means no position: there is nothing
// smaller than one contract.
int riskSize = 0
if not na(riskPerContract) and riskPerContract > 0
    riskSize := int(math.floor(riskBudget / riskPerContract))
    if riskSize > maxContracts
        riskSize := maxContracts

// What the account can actually carry, which the budget knows nothing about.
// A size the margin cannot cover is refused by the broker emulator without a
// word: the diagnostics read a size and the book stays flat.
//
// The percentage mirrors margin_long and margin_short in the declaration at
// the top of the script. Pine cannot read those back, so the number lives in
// two places; change both or neither.
MARGIN_PCT = 2.0

marginPerContract = close * syminfo.pointvalue * MARGIN_PCT / 100.0
marginAffords     = marginPerContract > 0 ? int(math.floor(strategy.equity / marginPerContract)) : 0
marginNeeds       = riskSize * marginPerContract

// ────────────────────────  POSITION MANAGER  ────────────────────────────
// Shown the book and the day, never the trade. Three gates on opening,
// and one rule about holding: nothing is carried past the hours.

maxOpen = input.int(1, "Positions at a time", minval = 1, group = G_PM,
     tooltip = "A signal that arrives with the book already this full is ignored. It is not remembered: nothing is taken later on its behalf.")
lossCut = input.int(2, "Losing trades that end the day", minval = 0, group = G_PM,
     tooltip = "Counted from the session opening. Reaching it stops new positions until the next session. Zero turns the cut off.")
winCut  = input.int(1, "Winning trades that end the day", minval = 0, group = G_PM,
     tooltip = "The same on the other side: the day can be ended by going well, not only by going badly. Zero turns the cut off.")

// Profit is net of commission, so a trade scratched to the tick lands on
// the losing side rather than in a third category neither cut would see.
var int pmWins   = 0
var int pmLosses = 0

// The cursor into the closed-trade list. Cumulative over the backtest, so
// unlike the tally it is never reset: that would count old trades again.
var int pmRead = 0

if isNewSession
    pmWins   := 0
    pmLosses := 0

if strategy.closedtrades > pmRead
    for i = pmRead to strategy.closedtrades - 1
        profit = strategy.closedtrades.profit(i)
        if profit > 0
            pmWins += 1
        else if profit < 0
            pmLosses += 1
    pmRead := strategy.closedtrades

pmDayOver = (lossCut > 0 and pmLosses >= lossCut) or (winCut > 0 and pmWins >= winCut)

// Read on the chart bar, since that is where an order would be placed.
pmBarMin  = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
pmInHours = pmBarMin >= tradingFrom and pmBarMin < tradingTo

pmAllows = pmInHours and not pmDayOver and strategy.opentrades < maxOpen

// The one rule that is not about opening. A target may never be reached,
// so the hours closing is what ends a position that is still running.
pmFlatten = strategy.position_size != 0 and not pmInHours

// ──────────────────────────────  ORDERS  ────────────────────────────────
// Where the two blocks meet: the intention, sized by one and permitted by
// the other. Nothing decides anything here.

// Held for as long as the position is, so the exit does not follow the
// levels a later signal would have used.
var float liveLoss   = na
var float liveTarget = na

if tradeDir != 0 and pmAllows and riskSize > 0
    liveLoss   := tradeLoss
    liveTarget := tradeTarget
    strategy.entry("Node", tradeDir > 0 ? strategy.long : strategy.short, qty = riskSize)

// A na target leaves the stop alone to work: the position then ends on the
// loss or on the hours.
if strategy.position_size != 0
    strategy.exit("Exit", "Node", stop = liveLoss, limit = liveTarget)

if pmFlatten
    strategy.close_all(comment = "Hours")

// ────────────────────────  DIAGNOSTICS  ─────────────────────────────────

if showDiag and barstate.islast
    diagRow(20, "hours",      (pmInHours ? "in" : "out") + "   " + clock(tradingFrom) + " – " + clock(tradingTo))
    diagRow(21, "budget",     str.tostring(riskBudget, "#.##") + (riskMode == RISK_FIXED ? "  fixed" : "  " + str.tostring(riskQty) + "% of " + str.tostring(riskEquity, "#.##")))
    diagRow(22, "per contract", na(riskPerContract) ? "— no trade" : str.tostring(riskPerContract, "#.##"))
    diagRow(23, "size",       str.tostring(riskSize) + (riskSize >= maxContracts ? "  at ceiling" : ""))
    diagRow(24, "open",       str.tostring(strategy.opentrades) + " / " + str.tostring(maxOpen))
    diagRow(25, "session W/L", str.tostring(pmWins) + " / " + str.tostring(pmLosses))
    diagRow(26, "day",        not pmDayOver ? "open" : pmWins >= winCut and winCut > 0 ? "closed · won" : "closed · lost")
    diagRow(27, "allows",     pmAllows ? "yes" : not pmInHours ? "no · outside hours" : pmDayOver ? "no · day is over" : "no · book is full")
    diagRow(29, "margin",     riskSize == 0 ? "—" : str.tostring(marginNeeds, "#.##") + " of " + str.tostring(strategy.equity, "#.##") + (riskSize > marginAffords ? "   REFUSED · affords " + str.tostring(marginAffords) : ""))
    diagRow(28, "position",   strategy.position_size == 0 ? "flat" : (strategy.position_size > 0 ? "long " : "short ") + str.tostring(math.abs(strategy.position_size)) + " @ " + str.tostring(strategy.position_avg_price, format.mintick))
