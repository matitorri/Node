// ════════════════════════════════  SETUP  ═══════════════════════════════
// Publishes the V object in play, not a verdict. See docs/setup.md.

var VObject setupObj  = na              // the region in play, or none
string      setupName = ""              // which setup put it there
bool        setupTook = false           // it took one on this bar

// ─────────────────────────  M TOUCH  ────────────────────────────────────

G_SETUPS = "Setups"

enableMSetup = input.bool(true, "Enable the M touch setup", group = G_SETUPS,
     tooltip = "Needs M objects to be enabled. With those off this setup can never take a region, and the diagnostics say so.")

mSetupReady = enableMSetup and enableM   // what it needs from the model

// ─────────────────────────  TRADING HOURS  ──────────────────────────────
// Read by this setup and by the position manager, so it is declared once
// and carries the position manager's group. It sits here rather than
// earlier only so the Portfolio section does not open above the model in
// the settings dialog.

G_PM = "Portfolio · Position management"

tradingHours = input.session("0930-1700", "Trading hours · New York time", group = G_PM,
     tooltip = "New York time, not the chart's timezone. The defaults are what the model already calls New York — set them to the hours you actually trade.")

// The session string reads "0930-1700": fixed offsets, whatever day mask
// may follow them.
hhmm(string s) => int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 2, 4)))

tradingFrom = hhmm(str.substring(tradingHours, 0, 4))
tradingTo   = hhmm(str.substring(tradingHours, 5, 9))

if isNewSession
    setupObj := na

// Let go of a region that no longer exists. Never on a target: the setup
// cannot see a position.
//
// Read on the bar, not on the grid. A slice is published once every five
// minutes, so on an M1 chart the region would stay in play for four more
// after price took the edge it lives off, and a change of character inside
// that window would trade something already gone.
if not na(setupObj)
    gone = setupObj.side > 0 ? low < setupObj.bot : high > setupObj.top
    if setupObj.eaten or gone or time >= setupObj.expire
        setupObj := na

// The touch is an event, and the model latches it on the region itself. The
// setup asks whether a region has been touched, not whether price is inside
// one now: without the event there is no setup, and after it there is one
// whether price is in or out.
//
// Asking about the present instead meant a region wide enough to contain
// price overnight armed the setup at the open of every day, with price
// having done nothing at all.
//
// The most recent qualifying region wins, which is why the list is walked
// from the end.

setupMin = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)

if mSetupReady and setupMin >= tradingFrom and setupMin < tradingTo
    if not array.includes(excludedDates, sessionDay(time)) and array.size(mObjects) > 0
        for i = array.size(mObjects) - 1 to 0
            cand = array.get(mObjects, i)
            if cand.touched and cand.active and not cand.eaten
                if na(setupObj) or setupObj.t != cand.t
                    setupTook := true
                setupObj := cand
                break

if not na(setupObj)
    setupName := "M touch"
