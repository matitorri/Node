//@version=6

indicator("NODE — Highest Volume Candle of the Day (H4) - v0.2.0", "NODE VolMax",
     overlay = true, max_labels_count = 500, max_boxes_count = 500)

// ─────────────────────────────  CONSTANTS  ──────────────────────────────

SRC_TF = "240"                          // source timeframe: H4
TF_MS  = 4 * 60 * 60 * 1000             // length of one H4 candle, in ms

// ─────────────────────────────  INPUTS  ─────────────────────────────────

markColor     = input.color(color.new(color.orange, 0), "Marker color")
showRange     = input.bool(true, "Highlight the H4 candle range")
showVolValue  = input.bool(true, "Show volume value on the label")
warnHigherTf  = input.bool(true, "Warn if the chart is above H4")

// ───────────────  MAXIMUM DETECTION (runs on the H4 series)  ────────────
// Keeps its own state on H4 bars, so the result is identical whether the
// chart is on M1 or on H4.

h4DailyMax() =>
    var float maxVol  = na
    var int   maxTime = na
    var float maxHigh = na
    var float maxLow  = na
    var int   dayNum  = 0               // increments once per day, used by
                                        // the chart side to know when to
                                        // start a new marker
    if timeframe.change("D") or na(maxVol)
        dayNum  += 1
        maxVol  := volume
        maxTime := time
        maxHigh := high
        maxLow  := low
    else if volume > maxVol
        maxVol  := volume
        maxTime := time
        maxHigh := high
        maxLow  := low
    [maxTime, maxHigh, maxLow, maxVol, dayNum]

[maxTime, maxHigh, maxLow, maxVol, dayNum] = request.security(
     syminfo.tickerid, SRC_TF, h4DailyMax(), lookahead = barmerge.lookahead_off)

// ──────────────────────────────  DRAWING  ───────────────────────────────

hasVol = not na(maxVol) and not na(maxTime)

var label dayLabel = na
var box   dayBox   = na

labelText(v) =>
    showVolValue ? "MAX VOL\n" + str.tostring(v, format.volume) : "MAX VOL"

if hasVol
    isNewDay = na(dayNum[1]) or dayNum != dayNum[1]

    if isNewDay or na(dayLabel)
        // New day: fresh markers, so the previous day's stay frozen.
        dayLabel := label.new(maxTime, maxHigh, labelText(maxVol),
             xloc      = xloc.bar_time,
             style     = label.style_label_down,
             color     = color.new(markColor, 15),
             textcolor = color.white,
             size      = size.small)
        if showRange
            dayBox := box.new(maxTime, maxHigh, maxTime + TF_MS, maxLow,
                 xloc         = xloc.bar_time,
                 border_color = markColor,
                 bgcolor      = color.new(markColor, 85))
    else
        // Same day: the winning candle may have changed, or the current
        // one may still be growing. Either way, refresh position and text.
        label.set_xy(dayLabel, maxTime, maxHigh)
        label.set_text(dayLabel, labelText(maxVol))
        if not na(dayBox)
            box.set_lefttop(dayBox, maxTime, maxHigh)
            box.set_rightbottom(dayBox, maxTime + TF_MS, maxLow)

// ──────────────────────────────  WARNINGS  ──────────────────────────────

if barstate.islast
    if warnHigherTf and timeframe.in_seconds() > timeframe.in_seconds(SRC_TF)
        label.new(bar_index, high, "Chart is above H4 (" + timeframe.period + ")\nThe H4 marker cannot be placed precisely",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)
    if not hasVol
        label.new(bar_index, high, "This symbol does not report volume on H4",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)

// ───────────────────────────────  ALERT  ────────────────────────────────
// Fires when a different H4 candle takes over as the maximum of the day.

isNewMax = hasVol and not na(maxTime[1]) and maxTime != maxTime[1] and dayNum == dayNum[1]
alertcondition(isNewMax, "NODE · New daily volume high",
     "A new H4 candle is now the highest-volume candle of the day")
