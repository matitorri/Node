//@version=6

indicator("Node - v0.13.0-dev", overlay = true, max_boxes_count = 500, max_labels_count = 50)

// ════════════════════════════════  SHARED  ══════════════════════════════
// Constants, inputs and the clock the three objects read. Nothing here
// belongs to one of them alone.

// ─────────────────────────────  CONSTANTS  ──────────────────────────────

SRC_TF       = "240"                    // M object source timeframe: H4
TF_MS        = 4 * 60 * 60 * 1000       // length of one H4 candle, in ms
ID_TF        = "60"                     // ID object source timeframe: H1
ID_TF_MIN    = 60                       // length of one H1 candle, in minutes
ID_TF_MS     = 60 * 60 * 1000
NY_START_MIN = 9 * 60                   // 09:00 ET, first candle of the NY set
NY_END_MIN   = 17 * 60                  // 17:00 ET, session close
MS_DAY       = 24 * 60 * 60 * 1000
NY_TZ        = "America/New_York"
NY_OPEN_MIN  = 9 * 60 + 30              // 09:30 ET, in minutes from midnight

// ─────────────────────────────  INPUTS  ─────────────────────────────────

// Groups, in the order they appear in the settings dialog.
G_COMMON = "Common"
G_M      = "M Objects"
G_ID     = "ID Objects"
G_NY     = "NY ID Object"

excludedInput = input.text_area(
     "2025-11-28, 2025-12-24, 2026-11-27, 2026-12-24",
     "Skipped sessions", group = G_COMMON,
     tooltip = "Sessions that produce no objects at all, one date per entry, comma or line separated. Dates are the session's closing day in New York time. Meant for holiday half sessions. Full closures need no entry: no bars, nothing to draw.")
warnPrecision = input.bool(true, "Warn when the chart is above M15", group = G_COMMON)

enableM      = input.bool(true, "Enable M objects", group = G_M,
     tooltip = "Off means no M object is ever created, not merely hidden. It also removes one of the two ways a NY ID object can arm, the other being an ID object getting swallowed.")
markColor    = input.color(color.new(color.orange, 0), "M object color", group = G_M)
lifetimeDays = input.int(3, "M object lifetime (days)", minval = 1, group = G_M,
     tooltip = "Counted from the source candle. An untouched M object is removed once it expires.")

enableId     = input.bool(true, "Enable ID objects", group = G_ID)
idColor      = input.color(color.new(color.blue, 0), "ID object color", group = G_ID)

enableNyId   = input.bool(true, "Enable NY ID object", group = G_NY)
nyIdColor    = input.color(color.new(color.purple, 0), "NY ID object color", group = G_NY)

// ────────────────────────  SKIPPED SESSIONS  ────────────────────────────
// The skip list, parsed once into YYYYMMDD numbers. Separators and any
// punctuation in the dates are stripped, so 2025-11-28 and 20251128 both work.
var array<int> excludedDates = array.new<int>()
if barstate.isfirst
    parts = str.split(str.replace_all(excludedInput, "\n", ","), ",")
    for i = 0 to array.size(parts) - 1
        raw   = array.get(parts, i)
        clean = str.replace_all(str.replace_all(str.replace_all(raw, "-", ""), "/", ""), " ", "")
        num   = str.tonumber(clean)
        if not na(num)
            array.push(excludedDates, int(num))

// A session's closing date is the New York date of every bar from midnight
// onwards, which is the whole window the two ID objects live in. The M
// object is born at the session turnover instead, and reads the date its
// own feed reports.
nyDate      = year(time, NY_TZ) * 10000 + month(time, NY_TZ) * 100 + dayofmonth(time, NY_TZ)
dayExcluded = array.includes(excludedDates, nyDate)

// ─────────────────────────  NEW YORK CLOCK  ─────────────────────────────
// isNyOpenBar marks the first bar at or after 09:30 ET, which closes an M
// object's trim window and gives birth to an ID object. inNy covers the
// New York stretch of the session.

nyMinutes = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
newNyDay  = na(time[1]) or dayofmonth(time, NY_TZ) != dayofmonth(time[1], NY_TZ)

var bool nyOpenSeen = false
if newNyDay
    nyOpenSeen := false
isNyOpenBar = not nyOpenSeen and nyMinutes >= NY_OPEN_MIN
if isNyOpenBar
    nyOpenSeen := true

inNy = nyMinutes >= NY_START_MIN and nyMinutes < NY_END_MIN

// Raised on any bar where price absorbs an M object or an ID object during
// New York, and read by the NY ID object. A pulse, not a latch: every one of
// these events makes the NY ID object pick again.
bool nyEvent = false

// ═══════════════════════════════  M OBJECT  ═════════════════════════════
// The price region left by the winning H4 candle of a session. Built over
// its trim window, then alive until price touches it. Publishes
// isNewSession, which the other two objects read.

// ───────────────  MAXIMUM DETECTION (runs on the H4 series)  ────────────
// Keeps its own state on H4 bars, so the winning candle is the same
// whether the chart is on M1 or on H4.

h4DailyMax() =>
    var float mVol   = na
    var int   mTime  = na
    var float mOpen  = na
    var float mHigh  = na
    var float mLow   = na
    var float mClose = na
    var int   dayNum = 0                // increments once per session, used
                                        // by the chart side to know when a
                                        // session's winner is final
    var int lastSessDate = na           // closing day of the session that
                                        // just ended, as YYYYMMDD
    if timeframe.change("D") or na(mVol)
        dayNum += 1
        lastSessDate := na(time[1]) ? na : year(time[1], NY_TZ) * 10000 + month(time[1], NY_TZ) * 100 + dayofmonth(time[1], NY_TZ)
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    else if volume > mVol
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    [mTime, mOpen, mHigh, mLow, mClose, mVol, dayNum, lastSessDate]

[wTime, wOpen, wHigh, wLow, wClose, wVol, dayNum, lastSessDate] = request.security(
     syminfo.tickerid, SRC_TF, h4DailyMax(), lookahead = barmerge.lookahead_off)

// ───────────────────────────  STATE  ────────────────────────────────────

type MObject
    int   t      = na                   // source candle open time
    float top    = na
    float bot    = na
    int   side   = 0                    // +1 bullish candle, -1 bearish
    float wMin   = na                   // trim window extremes
    float wMax   = na
    bool  active = false                // trimmed and touchable
    bool  frozen = false                // touched: the box stopped growing,
                                        // but the region is still watched
    bool  eaten  = false                // price took the edge its side lives
                                        // off, so the region is gone
    int   expire = na
    box   bx     = na

var array<MObject> mObjects = array.new<MObject>()
var MObject prov = na                   // winner of the session in progress

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

isNewSession = dayNum != nz(dayNum[1], 0)
winnerMoved  = wTime != wTime[1]

if not na(wTime)
    objSide = wClose > wOpen ? 1 : wClose < wOpen ? -1 : 0

    if isNewSession
        // The previous session is closed, so its winner is final. Only now
        // does the M object get drawn: while the session is running the
        // winner can still change hands, and the region cannot be used yet.
        // Holiday half sessions still open a daily bar, so they would produce
        // an M object on a fraction of the usual volume. Skipped by date.
        sessionOk = na(lastSessDate) or not array.includes(excludedDates, lastSessDate)

        if not na(prov)
            if enableM and prov.side != 0 and sessionOk
                prov.expire := prov.t + lifetimeDays * MS_DAY
                prov.bx := box.new(prov.t, prov.top, time, prov.bot,
                     xloc         = xloc.bar_time,
                     border_color = markColor,
                     bgcolor      = color.new(markColor, 85))
                array.push(mObjects, prov)
        prov := MObject.new(t = wTime, top = wHigh, bot = wLow, side = objSide)

    else if winnerMoved and not na(prov)
        // A later candle took over: move the M object and restart its window.
        prov.t    := wTime
        prov.top  := wHigh
        prov.bot  := wLow
        prov.side := objSide
        prov.wMin := na
        prov.wMax := na

// The window opens at the close of the source candle, which happens well
// before the session ends, so it is measured while the winner is still
// provisional and carried over when the M object is created. Nothing is
// drawn during this stage.
if not na(prov)
    if time >= prov.t + TF_MS
        prov.wMin := na(prov.wMin) ? low : math.min(prov.wMin, low)
        prov.wMax := na(prov.wMax) ? high : math.max(prov.wMax, high)

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if array.size(mObjects) > 0
    for i = array.size(mObjects) - 1 to 0
        obj = array.get(mObjects, i)
        bool drop = false

        if not obj.active
            if isNyOpenBar
                // Window closed. What survives is the part of the M object
                // price never visited, on the side the candle came from.
                float newTop = obj.side > 0 ? math.min(obj.top, nz(obj.wMin, obj.top)) : obj.top
                float newBot = obj.side < 0 ? math.max(obj.bot, nz(obj.wMax, obj.bot)) : obj.bot
                if newTop <= newBot
                    // Fully absorbed.
                    box.delete(obj.bx)
                    drop := true
                else
                    obj.top    := newTop
                    obj.bot    := newBot
                    obj.active := true
                    box.set_lefttop(obj.bx, obj.t, newTop)
                    box.set_rightbottom(obj.bx, time, newBot)
            else
                obj.wMin := na(obj.wMin) ? low : math.min(obj.wMin, low)
                obj.wMax := na(obj.wMax) ? high : math.max(obj.wMax, high)
                box.set_right(obj.bx, time)

        if not drop and obj.active
            if obj.frozen
                // The box is settled, but the region stays on the books so a
                // later candle can still be credited with absorbing it.
                if time >= obj.expire
                    drop := true
            else if high >= obj.bot and low <= obj.top
                // Touched: freeze the box where it happened.
                box.set_right(obj.bx, time)
                obj.frozen := true
            else if time >= obj.expire
                box.delete(obj.bx)
                drop := true
            else
                box.set_right(obj.bx, time)

        // The trim already leaves price on the side the candle came from, so
        // the edge that ends the region is the far one: a bullish region dies
        // on its low, a bearish one on its high. Absorbed during New York,
        // it arms the NY ID object, and so does an ID object going the same
        // way.
        if not drop and obj.active and not obj.eaten
            if obj.side > 0 ? low < obj.bot : high > obj.top
                obj.eaten := true
                if inNy
                    nyEvent := true

        if drop
            array.remove(mObjects, i)

// ══════════════════════════════  ID OBJECT  ═════════════════════════════
// The region left by the highest-volume H1 candle of the window running
// from the session open to the New York open. Untrimmed, born at the open,
// frozen on touch, gone with its session.

// ──────────  PRE-NEW-YORK SURVIVOR (runs on the H1 series)  ────────────
// Every H1 candle of the window that runs from the session open to the New
// York open is kept until price absorbs it. The winner is the highest-volume
// candle still standing, so being absorbed hands the place to the next one
// down. Dojis are never candidates: with no side there is no edge to lose.

h1PreNySurvivor() =>
    var array<int>   cTime = array.new<int>()
    var array<float> cHigh = array.new<float>()
    var array<float> cLow  = array.new<float>()
    var array<float> cVol  = array.new<float>()
    var array<int>   cSide = array.new<int>()
    var array<bool>  cGone = array.new<bool>()
    var bool inWin = false

    if timeframe.change("D")
        inWin := true
        array.clear(cTime)
        array.clear(cHigh)
        array.clear(cLow)
        array.clear(cVol)
        array.clear(cSide)
        array.clear(cGone)

    nyMin = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
    // The window closes on the first candle that would run past 09:30 ET.
    // Evening candles sit above 12:00 ET, so they cannot close it early.
    if inWin and nyMin < 720 and nyMin + ID_TF_MIN > NY_OPEN_MIN
        inWin := false

    if inWin
        // Age the candles already stored before adding this one, so a candle
        // is never measured against its own range.
        if array.size(cTime) > 0
            for i = 0 to array.size(cTime) - 1
                if not array.get(cGone, i)
                    if array.get(cSide, i) > 0 ? low < array.get(cLow, i) : high > array.get(cHigh, i)
                        array.set(cGone, i, true)
        candleSide = close > open ? 1 : close < open ? -1 : 0
        if candleSide != 0
            array.push(cTime, time)
            array.push(cHigh, high)
            array.push(cLow,  low)
            array.push(cVol,  volume)
            array.push(cSide, candleSide)
            array.push(cGone, false)

    // Highest volume among the candles still standing. The winner reaches
    // the open un-absorbed by construction: one that had lost its edge would
    // already have dropped out.
    int   bTime = na
    float bHigh = na
    float bLow  = na
    float bVol  = na
    int   bSide = 0
    if array.size(cTime) > 0
        for i = 0 to array.size(cTime) - 1
            if not array.get(cGone, i)
                v = array.get(cVol, i)
                if na(bVol) or v > bVol
                    bVol  := v
                    bTime := array.get(cTime, i)
                    bHigh := array.get(cHigh, i)
                    bLow  := array.get(cLow, i)
                    bSide := array.get(cSide, i)
    [bTime, bHigh, bLow, bVol, bSide]

[idSrcTime, idSrcHigh, idSrcLow, idSrcVol, idSrcSide] = request.security(
     syminfo.tickerid, ID_TF, h1PreNySurvivor(), lookahead = barmerge.lookahead_off)

// ───────────────────────────  STATE  ────────────────────────────────────

var box   idBox     = na                // pre-NY ID object of this session
var float idTop     = na
var float idBot     = na
var bool  idTouched = false             // the box stopped growing
var int   idSide    = 0                 // of its source candle: which edge
var bool  idEaten   = false             // losing it means absorbed

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

if isNewSession
    if not na(idBox)
        box.delete(idBox)
    idBox     := na
    idTop     := na
    idBot     := na
    idTouched := false
    idSide    := 0
    idEaten   := false

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────
// Born at the New York open from the highest-volume H1 candle of the pre-NY
// window that price did not absorb. No trim, and it dies with its session.

if enableId and isNyOpenBar and not dayExcluded and not na(idSrcTime)
    idTop     := idSrcHigh
    idBot     := idSrcLow
    idTouched := false
    idSide    := idSrcSide
    idEaten   := false
    idBox := box.new(idSrcTime, idSrcHigh, time, idSrcLow,
         xloc         = xloc.bar_time,
         border_color = idColor,
         bgcolor      = color.new(idColor, 85))

// Same rule as an M object: the region projects right until price enters it,
// then the box freezes where that happened. It is still removed with its
// session, touched or not.
if not na(idBox) and not idTouched
    box.set_right(idBox, time)
    if high >= idBot and low <= idTop
        idTouched := true

// Absorption is a different matter from being touched, and it keeps being
// watched after the box settles. A bullish region lives off its low and a
// bearish one off its high: lose that edge, by a tick, and the region is
// gone. One absorbed during New York arms the NY ID object.
if not na(idBox) and not idEaten
    if idSide > 0 ? low < idBot : high > idTop
        idEaten := true
        if inNy
            nyEvent := true

// ═════════════════════════════  NY ID OBJECT  ═══════════════════════════
// Price absorbing an M object or an ID object during New York is an event.
// Every one of them picks the region again: the highest-volume New York H1
// candle standing at that instant, the one still forming included, read at
// whatever it has reached by then. Between events nothing moves. It ends
// when price absorbs the region in turn, and the session gives no more.

// ───────────────────────────  STATE  ────────────────────────────────────

var box   nyBox    = na                 // NY ID object of this session
var int   nyDrawnT = na                 // candle it was taken from
var float nyTop    = na                 // as drawn, which for a candle still
var float nyBot    = na                 // forming is not its final range
var int   nySide   = 0                  // which edge ends it
var bool  nyDone   = false              // price took that edge

// The H1 candle in progress, accumulated from chart bars. request.security
// cannot hand back an unclosed candle on history, and an unclosed candle is
// exactly what may have to be picked.
var int   curT = na
var float curO = na
var float curH = na
var float curL = na
var float curC = na
var float curV = na

// Every New York H1 candle that has closed, dropped once price takes the
// edge its side lives off, so an absorbed one stays out of the choice.
var array<int>   nyT    = array.new<int>()
var array<float> nyH    = array.new<float>()
var array<float> nyL    = array.new<float>()
var array<float> nyV    = array.new<float>()
var array<int>   nySd   = array.new<int>()
var array<bool>  nyGone = array.new<bool>()

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

if isNewSession
    if not na(nyBox)
        box.delete(nyBox)
    nyBox    := na
    nyDrawnT := na
    nyTop    := na
    nyBot    := na
    nySide   := 0
    nyDone   := false
    curT     := na                      // so the candle straddling the
    curO     := na                      // turnover is not filed under the
    curH     := na                      // session that is starting
    curL     := na
    curC     := na
    curV     := na
    array.clear(nyT)
    array.clear(nyH)
    array.clear(nyL)
    array.clear(nyV)
    array.clear(nySd)
    array.clear(nyGone)

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if timeframe.change(ID_TF) or na(curT)
    // The candle that just ended joins the closed ones, unless it closed a
    // doji and so has no edge to lose.
    if not na(curT)
        endedSide  = curC > curO ? 1 : curC < curO ? -1 : 0
        endedNyMin = hour(curT, NY_TZ) * 60 + minute(curT, NY_TZ)
        if endedSide != 0 and endedNyMin >= NY_START_MIN and endedNyMin < NY_END_MIN
            array.push(nyT,    curT)
            array.push(nyH,    curH)
            array.push(nyL,    curL)
            array.push(nyV,    curV)
            array.push(nySd,   endedSide)
            array.push(nyGone, false)
    curT := time
    curO := open
    curH := high
    curL := low
    curC := close
    curV := nz(volume)
else
    curH := math.max(curH, high)
    curL := math.min(curL, low)
    curC := close
    curV := curV + nz(volume)

// Age the closed ones, so an absorbed candle cannot be chosen later.
if array.size(nyT) > 0
    for i = 0 to array.size(nyT) - 1
        if not array.get(nyGone, i) and time >= array.get(nyT, i) + ID_TF_MS
            if array.get(nySd, i) > 0 ? low < array.get(nyL, i) : high > array.get(nyH, i)
                array.set(nyGone, i, true)

// Highest volume among the candles still standing, the one in progress
// included at whatever volume it has reached.
int   nyBestT = na
float nyBestH = na
float nyBestL = na
float nyBestV = na
int   nyBestS = 0
if array.size(nyT) > 0
    for i = 0 to array.size(nyT) - 1
        if not array.get(nyGone, i)
            v = array.get(nyV, i)
            if na(nyBestV) or v > nyBestV
                nyBestV := v
                nyBestT := array.get(nyT, i)
                nyBestH := array.get(nyH, i)
                nyBestL := array.get(nyL, i)
                nyBestS := array.get(nySd, i)

curNyMin  = na(curT) ? na : hour(curT, NY_TZ) * 60 + minute(curT, NY_TZ)
curSide   = na(curT) ? 0 : curC > curO ? 1 : curC < curO ? -1 : 0
if not na(curNyMin) and curNyMin >= NY_START_MIN and curNyMin < NY_END_MIN and curSide != 0
    if na(nyBestV) or curV > nyBestV
        nyBestV := curV
        nyBestT := curT
        nyBestH := curH
        nyBestL := curL
        nyBestS := curSide

// Redrawn on every event, and only on an event: a bigger candle closing in
// between does not take the place on its own.
if enableNyId and nyEvent and not nyDone and not dayExcluded and not na(nyBestT)
    if not na(nyBox)
        box.delete(nyBox)
    nyDrawnT := nyBestT
    nyTop    := nyBestH
    nyBot    := nyBestL
    nySide   := nyBestS
    nyBox := box.new(nyBestT, nyBestH, time, nyBestL,
         xloc         = xloc.bar_time,
         border_color = nyIdColor,
         bgcolor      = color.new(nyIdColor, 85))

// Measured against the region as drawn, not against what its source candle
// went on to become.
if not na(nyBox) and not nyDone
    box.set_right(nyBox, time)
    if nySide > 0 ? low < nyBot : high > nyTop
        nyDone := true

// ════════════════════════════════  OUTPUT  ══════════════════════════════

if barstate.islast
    if warnPrecision and timeframe.in_seconds() > timeframe.in_seconds("15")
        label.new(bar_index, high, "Chart is above M15 (" + timeframe.period + ")\nThe 09:30 ET cut-off is approximated to the bar",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)
    if na(wVol)
        label.new(bar_index, high, "This symbol does not report volume on H4",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)

isNewMax = not na(wTime) and not na(wTime[1]) and wTime != wTime[1] and dayNum == nz(dayNum[1], 0)
alertcondition(isNewMax, "Node · New daily volume high",
     "A new H4 candle is now the highest-volume candle of the day")
