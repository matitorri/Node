//@version=6

indicator("NODE — Highest Volume Candle of the Day (H4) - v0.5.0", "NODE VolMax",
     overlay = true, max_boxes_count = 500, max_labels_count = 50)

// ─────────────────────────────  CONSTANTS  ──────────────────────────────

SRC_TF       = "240"                    // source timeframe: H4
TF_MS        = 4 * 60 * 60 * 1000       // length of one H4 candle, in ms
MS_DAY       = 24 * 60 * 60 * 1000
NY_TZ        = "America/New_York"
NY_OPEN_MIN  = 9 * 60 + 30              // 09:30 ET, in minutes from midnight

// ─────────────────────────────  INPUTS  ─────────────────────────────────

markColor    = input.color(color.new(color.orange, 0), "Node color")
lifetimeDays = input.int(3, "Node lifetime (days)", minval = 1,
     tooltip = "Counted from the node candle. An untouched node is removed once it expires.")
minSessVolPct = input.float(50, "Minimum session volume (% of median)", minval = 0, maxval = 100, step = 5,
     tooltip = "Sessions trading less than this share of the recent median are skipped, which drops half sessions around holidays. Set to 0 to keep every session.")
volLookback = input.int(20, "Sessions for the volume median", minval = 2)
warnPrecision = input.bool(true, "Warn when the chart is above M15")

// ───────────────  MAXIMUM DETECTION (runs on the H4 series)  ────────────
// Keeps its own state on H4 bars, so the winning candle is the same
// whether the chart is on M1 or on H4.

h4DailyMax() =>
    var float mVol   = na
    var int   mTime  = na
    var float mOpen  = na
    var float mHigh  = na
    var float mLow   = na
    var float mClose = na
    var int   dayNum = 0                // increments once per session, used
                                        // by the chart side to know when a
                                        // session's winner is final
    var float sessVol     = 0.0         // volume traded so far this session
    var float lastSessVol = na          // total of the session that just ended
    if timeframe.change("D") or na(mVol)
        dayNum      += 1
        lastSessVol := sessVol
        sessVol     := nz(volume)
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    else
        sessVol += nz(volume)
        if volume > mVol
            mVol   := volume
            mTime  := time
            mOpen  := open
            mHigh  := high
            mLow   := low
            mClose := close
    [mTime, mOpen, mHigh, mLow, mClose, mVol, dayNum, lastSessVol]

[nTime, nOpen, nHigh, nLow, nClose, nVol, dayNum, lastSessVol] = request.security(
     syminfo.tickerid, SRC_TF, h4DailyMax(), lookahead = barmerge.lookahead_off)

// Reference level for the session filter: the median volume of the sessions
// before the one that just closed, so a half session cannot lower its own bar.
sessVolRef = request.security(syminfo.tickerid, "D", ta.median(volume, volLookback)[1],
     lookahead = barmerge.lookahead_off)

// ──────────────────────────────  NODE  ──────────────────────────────────
// A node is the price region left by the winning candle. It is built over
// the trim window, then lives on the chart until price touches it.

type Node
    int   t      = na                   // node candle open time
    float top    = na
    float bot    = na
    int   side   = 0                    // +1 bullish candle, -1 bearish
    float wMin   = na                   // trim window extremes
    float wMax   = na
    bool  active = false                // trimmed and touchable
    int   expire = na
    box   bx     = na

var array<Node> nodes = array.new<Node>()
var Node prov = na                      // winner of the session in progress

// ─────────────────────  NEW YORK OPEN DETECTION  ────────────────────────
// The trim window closes on the first bar at or after 09:30 ET.

nyMinutes = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
newNyDay  = na(time[1]) or dayofmonth(time, NY_TZ) != dayofmonth(time[1], NY_TZ)

var bool nyOpenSeen = false
if newNyDay
    nyOpenSeen := false
isNyOpenBar = not nyOpenSeen and nyMinutes >= NY_OPEN_MIN
if isNyOpenBar
    nyOpenSeen := true

// ───────────────────────  SESSION WINNER TRACKING  ──────────────────────

isNewSession = dayNum != nz(dayNum[1], 0)
winnerMoved  = nTime != nTime[1]

if not na(nTime)
    nodeSide = nClose > nOpen ? 1 : nClose < nOpen ? -1 : 0

    if isNewSession
        // The previous session is closed, so its winner is final. Only now
        // does the node get drawn: while the session is running the winner
        // can still change hands, and the region cannot be used yet.
        // A session that barely traded — a holiday half session — produces a
        // node that is not comparable to a normal one, so it is skipped.
        volFloor  = na(sessVolRef) ? na : sessVolRef * minSessVolPct / 100.0
        sessionOk = minSessVolPct <= 0 or na(volFloor) or na(lastSessVol) or lastSessVol >= volFloor

        if not na(prov)
            if prov.side != 0 and sessionOk
                prov.expire := prov.t + lifetimeDays * MS_DAY
                prov.bx := box.new(prov.t, prov.top, time, prov.bot,
                     xloc         = xloc.bar_time,
                     border_color = markColor,
                     bgcolor      = color.new(markColor, 85))
                array.push(nodes, prov)
        prov := Node.new(t = nTime, top = nHigh, bot = nLow, side = nodeSide)

    else if winnerMoved and not na(prov)
        // A later candle took over: move the node and restart its window.
        prov.t    := nTime
        prov.top  := nHigh
        prov.bot  := nLow
        prov.side := nodeSide
        prov.wMin := na
        prov.wMax := na

// The window opens at the close of the node candle, which happens well
// before the session ends, so it is measured while the winner is still
// provisional and carried over when the node is finalised. Nothing is drawn
// during this stage.
if not na(prov)
    if time >= prov.t + TF_MS
        prov.wMin := na(prov.wMin) ? low : math.min(prov.wMin, low)
        prov.wMax := na(prov.wMax) ? high : math.max(prov.wMax, high)

// ────────────────────────────  NODE LIFECYCLE  ──────────────────────────

if array.size(nodes) > 0
    for i = array.size(nodes) - 1 to 0
        nd = array.get(nodes, i)
        bool drop = false

        if not nd.active
            if isNyOpenBar
                // Window closed. What survives is the part of the node the
                // price never visited, on the side the candle came from.
                float newTop = nd.side > 0 ? math.min(nd.top, nz(nd.wMin, nd.top)) : nd.top
                float newBot = nd.side < 0 ? math.max(nd.bot, nz(nd.wMax, nd.bot)) : nd.bot
                if newTop <= newBot
                    // Fully absorbed.
                    box.delete(nd.bx)
                    drop := true
                else
                    nd.top    := newTop
                    nd.bot    := newBot
                    nd.active := true
                    box.set_lefttop(nd.bx, nd.t, newTop)
                    box.set_rightbottom(nd.bx, time, newBot)
            else
                nd.wMin := na(nd.wMin) ? low : math.min(nd.wMin, low)
                nd.wMax := na(nd.wMax) ? high : math.max(nd.wMax, high)
                box.set_right(nd.bx, time)

        if not drop and nd.active
            if high >= nd.bot and low <= nd.top
                // Touched: freeze the box where it happened and stop tracking.
                box.set_right(nd.bx, time)
                drop := true
            else if time >= nd.expire
                box.delete(nd.bx)
                drop := true
            else
                box.set_right(nd.bx, time)

        if drop
            array.remove(nodes, i)

// ──────────────────────────────  WARNINGS  ──────────────────────────────

if barstate.islast
    if warnPrecision and timeframe.in_seconds() > timeframe.in_seconds("15")
        label.new(bar_index, high, "Chart is above M15 (" + timeframe.period + ")\nThe 09:30 ET cut-off is approximated to the bar",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)
    if na(nVol)
        label.new(bar_index, high, "This symbol does not report volume on H4",
             style = label.style_label_down, color = color.new(color.red, 10),
             textcolor = color.white, size = size.small)

// ───────────────────────────────  ALERT  ────────────────────────────────

isNewMax = not na(nTime) and not na(nTime[1]) and nTime != nTime[1] and dayNum == nz(dayNum[1], 0)
alertcondition(isNewMax, "NODE · New daily volume high",
     "A new H4 candle is now the highest-volume candle of the day")
