// ═════════════════════════════  DIAGNOSTICS  ════════════════════════════
// Shared, and appended to by the portfolio. Row numbers are fixed rather
// than running, so a section can add rows without knowing what another
// did; a row nobody fills is never drawn. See docs/diagnostics.md.

stamp(int t) => na(t) ? "—" : str.format_time(t, "yyyy-MM-dd HH:mm", NY_TZ)
sided(int sd) => sd > 0 ? "long" : sd < 0 ? "short" : "—"
// Pine's integer division yields a float, so the hour is floored rather
// than left to a format string to round.
clock(int m) =>
    h  = math.floor(m / 60)
    mm = m % 60
    (h < 10 ? "0" : "") + str.tostring(h) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm)

var table diag = table.new(position.top_right, 2, 36, border_width = 1,
     frame_width = 1, frame_color = color.gray)

diagRow(int r, string k, string v) =>
    table.cell(diag, 0, r, k, text_color = color.gray, text_size = size.tiny,
         text_halign = text.align_right, bgcolor = color.new(color.black, 85))
    table.cell(diag, 1, r, v, text_color = color.white, text_size = size.tiny,
         text_halign = text.align_left, bgcolor = color.new(color.black, 85))

if showDiag and barstate.islast
    // Where the M objects actually are. A count says two and the chart shows
    // one, and there is no way to tell which region a setup took.
    string mList = ""
    if array.size(mObjects) > 0
        for i = 0 to array.size(mObjects) - 1
            o = array.get(mObjects, i)
            mList := mList + (i > 0 ? "    " : "") + str.tostring(o.bot, format.mintick) + "–" + str.tostring(o.top, format.mintick) + " " + sided(o.side) + (not o.active ? " trimming" : o.frozen ? " touched" : " live") + (o.eaten ? " · absorbed" : "")

    diagRow(0,  "chart",         timeframe.period + (coarse ? "  split" : "  bucketed"))
    diagRow(1,  "slices / bar",  str.tostring(array.size(slT)))
    diagRow(2,  "bar",           stamp(time) + "   session " + str.tostring(sessionDay(time)) + (array.includes(excludedDates, sessionDay(time)) ? " · SKIPPED" : "") + "   " + str.tostring(array.size(excludedDates)) + " listed")
    diagRow(3,  "H4 dayNum",     str.tostring(dayNum) + (isNewSession ? "   turning" : ""))
    diagRow(4,  "H4 sess date",  na(lastSessDate) ? "—" : str.tostring(lastSessDate))
    diagRow(5,  "last turnover", stamp(lastTurnT))
    diagRow(6,  "M alive",       str.tostring(array.size(mObjects)) + (mList == "" ? "" : "   " + mList))
    diagRow(7,  "ID source",     stamp(idSrcTime) + "  " + sided(idSrcSide))
    diagRow(8,  "ID born",       na(idObj) ? "—" : stamp(idObj.born))
    diagRow(9,  "ID range",      na(idObj) ? "no box" : str.tostring(idObj.bot, format.mintick) + " – " + str.tostring(idObj.top, format.mintick) + "  " + sided(idObj.side))
    diagRow(10, "ID state",      na(idObj) ? "—" : (idObj.frozen ? "touched" : "live") + (idObj.eaten ? " · absorbed" : ""))
    diagRow(11, "structure",     not structOn ? "off" : (structPhase > 0 ? "up" : "down"))
    diagRow(12, "struct levels", not structOn ? "—" : str.tostring(structLow, format.mintick) + " – " + str.tostring(structHigh, format.mintick) + "   " + str.tostring(structPts) + " pts")
    diagRow(13, "last CHoCH",    not structOn ? "—" : stamp(structChT) + "  " + (structChDir > 0 ? "to up" : structChDir < 0 ? "to down" : "—") + "   ×" + str.tostring(structChCount))
    diagRow(14, "setup",         not mSetupReady ? "M touch · needs M objects" : na(setupObj) ? "M touch · idle" : "M touch · holding " + str.tostring(setupObj.bot, format.mintick) + " – " + str.tostring(setupObj.top, format.mintick))
    diagRow(15, "signal",        not signalFired ? "—" : signalDir > 0 ? "fired up" : "fired down")

    // Latent objects: what the model holds against what the chart shows.
    // Counted by walking the classes, so a class added is a class reported.
    string lvlList = ""
    for k = 0 to array.size(clsLabel) - 1
        int n = 0
        if array.size(levels) > 0
            for i = 0 to array.size(levels) - 1
                if clsOf(array.get(levels, i).age) == k
                    n := n + 1
        lvlList := lvlList + (k > 0 ? " · " : "") + array.get(clsLabel, k) + " " + str.tostring(n)
    int latWait = 0
    int latHit  = 0
    if array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            if array.get(latents, i).hit
                latHit := latHit + 1
            else
                latWait := latWait + 1

    diagRow(30, "daily feed",  stamp(dTime))
    diagRow(31, "levels",      not enableLatent ? "off" : lvlList + "   " + str.tostring(array.size(levels)) + " held   " + str.tostring(drawnLevels) + " drawn")
    diagRow(32, "latent",      not enableLatent ? "off" : str.tostring(latWait) + " waiting · " + str.tostring(latHit) + " retested   " + str.tostring(drawnLatent) + " drawn")
