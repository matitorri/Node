// ════════════════════════════════  SHARED  ══════════════════════════════
// Constants, inputs, the evaluation grid and the clock the three objects
// read. Nothing here belongs to one of them alone.

// ─────────────────────────────  CONSTANTS  ──────────────────────────────

SRC_TF       = "240"                    // M object source timeframe: H4
TF_MS        = 4 * 60 * 60 * 1000       // length of one H4 candle, in ms
ID_TF        = "60"                     // ID object source timeframe: H1
ID_TF_MIN    = 60                       // length of one H1 candle, in minutes
ID_TF_MS     = 60 * 60 * 1000
EVAL_TF      = "5"                      // everything is judged on this grid
EVAL_MS      = 5 * 60 * 1000
NY_START_MIN = 9 * 60                   // 09:00 ET, first candle of the NY set
NY_END_MIN   = 17 * 60                  // 17:00 ET, session close
MS_DAY       = 24 * 60 * 60 * 1000
NY_TZ        = "America/New_York"
NY_OPEN_MIN  = 9 * 60 + 30              // 09:30 ET, in minutes from midnight
SESS_OPEN_MIN = 18 * 60                 // 18:00 ET, when the session opens

// ─────────────────────────────  INPUTS  ─────────────────────────────────

// Groups, in the order they appear in the settings dialog.
G_COMMON = "Common"
G_M      = "V Objects · M"
G_ID     = "V Objects · ID"
G_NY     = "V Objects · NY ID"

excludedInput = input.text_area(
     "2025-11-28, 2025-12-24, 2026-11-27, 2026-12-24",
     "Skipped sessions", group = G_COMMON,
     tooltip = "Sessions that produce no objects at all, one date per entry, comma or line separated. Dates are the session's closing day in New York time. Meant for holiday half sessions. Full closures need no entry: no bars, nothing to draw.")
warnGrid = input.bool(true, "Warn when the chart does not fit the grid", group = G_COMMON)
showDiag = input.bool(false, "Diagnostics table", group = G_COMMON,
     tooltip = "Reports the state behind the drawings on the last bar: what the feeds say the session is, when the last turnover happened, and where each object stands.")

enableM      = input.bool(true, "Enable M objects", group = G_M,
     tooltip = "Off means no M object is ever created, not merely hidden. It also removes one of the two ways a NY ID object can be triggered, the other being an ID object getting absorbed.")
markColor    = input.color(color.new(color.orange, 0), "M object color", group = G_M)
lifetimeDays = input.int(3, "M object lifetime (days)", minval = 1, group = G_M,
     tooltip = "Counted from the source candle. An untouched M object is removed once it expires.")

enableId     = input.bool(true, "Enable ID objects", group = G_ID)
idColor      = input.color(color.new(color.blue, 0), "ID object color", group = G_ID)

enableNyId   = input.bool(true, "Enable NY ID object", group = G_NY)
nyIdColor    = input.color(color.new(color.purple, 0), "NY ID object color", group = G_NY)

// ────────────────────────  SKIPPED SESSIONS  ────────────────────────────
// The skip list, parsed once into YYYYMMDD numbers. Separators and any
// punctuation in the dates are stripped, so 2025-11-28 and 20251128 both work.

var array<int> excludedDates = array.new<int>()
if barstate.isfirst
    parts = str.split(str.replace_all(excludedInput, "\n", ","), ",")
    for i = 0 to array.size(parts) - 1
        raw   = array.get(parts, i)
        clean = str.replace_all(str.replace_all(str.replace_all(raw, "-", ""), "/", ""), " ", "")
        num   = str.tonumber(clean)
        if not na(num)
            array.push(excludedDates, int(num))

// ──────────────────────────  EVALUATION GRID  ───────────────────────────
// Every judgement below — the clock, a touch, an absorption, a New York
// candle — is made on five-minute slices instead of on chart bars, so a
// session produces the same objects whatever timeframe is on screen.
// Charts coarser than the grid are split into their five-minute intrabars;
// finer ones are gathered into five-minute buckets and read out whole.

coarse = timeframe.in_seconds() > 300
evalTf = coarse ? EVAL_TF : timeframe.period

[ltfT, ltfO, ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(
     syminfo.tickerid, evalTf, [time, open, high, low, close, volume])

var array<int>   slT = array.new<int>()
var array<float> slO = array.new<float>()
var array<float> slH = array.new<float>()
var array<float> slL = array.new<float>()
var array<float> slC = array.new<float>()
var array<float> slV = array.new<float>()

var int   bkT = na                      // bucket under construction, used
var float bkO = na                      // only on charts finer than the grid
var float bkH = na
var float bkL = na
var float bkV = 0.0

array.clear(slT)
array.clear(slO)
array.clear(slH)
array.clear(slL)
array.clear(slC)
array.clear(slV)

if coarse
    if array.size(ltfT) > 0
        for i = 0 to array.size(ltfT) - 1
            array.push(slT, array.get(ltfT, i))
            array.push(slO, array.get(ltfO, i))
            array.push(slH, array.get(ltfH, i))
            array.push(slL, array.get(ltfL, i))
            array.push(slC, array.get(ltfC, i))
            array.push(slV, array.get(ltfV, i))
else
    if na(bkT)
        bkT := time - time % EVAL_MS
        bkO := open
        bkH := high
        bkL := low
        bkV := 0.0
    bkH := math.max(bkH, high)
    bkL := math.min(bkL, low)
    bkV := bkV + nz(volume)
    if time_close % EVAL_MS == 0
        array.push(slT, bkT)
        array.push(slO, bkO)
        array.push(slH, bkH)
        array.push(slL, bkL)
        array.push(slC, close)
        array.push(slV, bkV)
        bkT := na

// ─────────────────────────  NEW YORK CLOCK  ─────────────────────────────
// Resolved per slice. slOpen marks the first slice at or past 09:30 ET,
// which closes an M object's trim window and gives birth to an ID object.
// slInNy covers the New York stretch, slSkip the sessions named in the list.
// slEvt is raised by whichever object price absorbs, and read by the NY ID
// object: a pulse per slice, not a latch held for the session.

var array<bool> slOpen = array.new<bool>()
var array<bool> slInNy = array.new<bool>()
var array<bool> slSkip = array.new<bool>()
var array<bool> slEvt  = array.new<bool>()

var bool nyOpenSeen = false
var int  lastNyDay  = na

array.clear(slOpen)
array.clear(slInNy)
array.clear(slSkip)
array.clear(slEvt)

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        t    = array.get(slT, k)
        mins = hour(t, NY_TZ) * 60 + minute(t, NY_TZ)
        dom  = dayofmonth(t, NY_TZ)
        if na(lastNyDay) or dom != lastNyDay
            nyOpenSeen := false
            lastNyDay  := dom
        // Bounded at both ends. Without the upper bound a Sunday reopen at
        // 18:00 ET counts as an opening, since it is the first trade of that
        // New York day and sits well past 09:30.
        isOpen = not nyOpenSeen and mins >= NY_OPEN_MIN and mins < NY_END_MIN
        if isOpen
            nyOpenSeen := true
        array.push(slOpen, isOpen)
        array.push(slInNy, mins >= NY_START_MIN and mins < NY_END_MIN)
        array.push(slSkip, array.includes(excludedDates,
             year(t, NY_TZ) * 10000 + month(t, NY_TZ) * 100 + dom))
        array.push(slEvt, false)

// ─────────────────────────  SESSION OPENING  ────────────────────────────
// The exchange session opens at 18:00 ET. Read off the clock rather than
// from timeframe.change("D"): around a holiday the daily series can run for
// days without reporting a change, which silently freezes every per-session
// reset hanging off it — the winner never resets, the pre-New-York window
// never clears, and objects from the old session stay on the chart.
//
// Each call site keeps its own state, so the same function serves both
// series it is used on.

sessionOpened() =>
    var int  lastDay = na
    var bool seen    = false
    d = dayofmonth(time, NY_TZ)
    if na(lastDay) or d != lastDay
        lastDay := d
        seen    := false
    fire = not seen and hour(time, NY_TZ) * 60 + minute(time, NY_TZ) >= SESS_OPEN_MIN
    if fire
        seen := true
    fire

// ══════════════════════════════  V OBJECTS  ═════════════════════════════
// A V object is a price region left behind by a candle that carried the
// volume, held until price takes the edge its side lives off. Three kinds,
// differing in the candle they come from and in how long they last:
//
//   M object      the session's H4 winner, trimmed, alive for days
//   ID object     the pre-New-York H1 winner, untrimmed, alive for a day
//   NY ID object  a New York H1 winner, drawn on an absorption event
//
// They share a vocabulary — side, touched, absorbed — and this type. The
// trim window and the expiry belong to M objects alone; the other two leave
// those fields untouched.

type VObject
    int   t      = na                   // source candle open time
    float top    = na
    float bot    = na
    int   side   = 0                    // +1 long, -1 short
    int   born   = na                   // when its box was drawn
    bool  frozen = false                // the box stopped growing
    bool  eaten  = false                // price took the edge its side lives
                                        // off, so the region is gone
    bool  active = false                // M only: trimmed and touchable
    float wMin   = na                   // M only: trim window extremes
    float wMax   = na
    int   expire = na                   // M only
    box   bx     = na

// ─────────────────────────────  M OBJECT  ───────────────────────────────
// The region left by the winning H4 candle of a session. Built over its
// trim window, then alive until price touches it. Publishes isNewSession,
// which the other two read.

// ───────────────  MAXIMUM DETECTION (runs on the H4 series)  ────────────
// Keeps its own state on H4 bars, so the winning candle is the same
// whether the chart is on M1 or on H4.

h4DailyMax() =>
    var float mVol   = na
    var int   mTime  = na
    var float mOpen  = na
    var float mHigh  = na
    var float mLow   = na
    var float mClose = na
    var int   dayNum = 0                // increments once per session, used
                                        // by the chart side to know when a
                                        // session's winner is final
    var int lastSessDate = na           // closing day of the session that
                                        // just ended, as YYYYMMDD
    if sessionOpened() or na(mVol)
        dayNum += 1
        lastSessDate := na(time[1]) ? na : year(time[1], NY_TZ) * 10000 + month(time[1], NY_TZ) * 100 + dayofmonth(time[1], NY_TZ)
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    else if volume > mVol
        mVol   := volume
        mTime  := time
        mOpen  := open
        mHigh  := high
        mLow   := low
        mClose := close
    [mTime, mOpen, mHigh, mLow, mClose, mVol, dayNum, lastSessDate]

[wTime, wOpen, wHigh, wLow, wClose, wVol, dayNum, lastSessDate] = request.security(
     syminfo.tickerid, SRC_TF, h4DailyMax(), lookahead = barmerge.lookahead_off)

// ───────────────────────────  STATE  ────────────────────────────────────

var array<VObject> mObjects = array.new<VObject>()
var VObject prov = na                   // winner of the session in progress
var int lastTurnT = na                  // when the session last turned over

// ────────────────────────  SESSION TURNOVER  ────────────────────────────
// Driven by the H4 feed rather than by the grid, since that is what decides
// when a session's winner is final.

isNewSession = dayNum != nz(dayNum[1], 0)
winnerMoved  = wTime != wTime[1]

if not na(wTime)
    objSide = wClose > wOpen ? 1 : wClose < wOpen ? -1 : 0

    if isNewSession
        lastTurnT := time

        // The previous session is closed, so its winner is final. Only now
        // does the M object get drawn: while the session is running the
        // winner can still change hands, and the region cannot be used yet.
        // Holiday half sessions still open a daily bar, so they would produce
        // an M object on a fraction of the usual volume. Skipped by date.
        sessionOk = na(lastSessDate) or not array.includes(excludedDates, lastSessDate)

        if not na(prov)
            if enableM and prov.side != 0 and sessionOk
                prov.expire := prov.t + lifetimeDays * MS_DAY
                prov.bx := box.new(prov.t, prov.top, time, prov.bot,
                     xloc         = xloc.bar_time,
                     border_color = markColor,
                     bgcolor      = color.new(markColor, 85))
                array.push(mObjects, prov)
        prov := VObject.new(t = wTime, top = wHigh, bot = wLow, side = objSide)

    else if winnerMoved and not na(prov)
        // A later candle took over: move the M object and restart its window.
        prov.t    := wTime
        prov.top  := wHigh
        prov.bot  := wLow
        prov.side := objSide
        prov.wMin := na
        prov.wMax := na

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        sT   = array.get(slT, k)
        sH   = array.get(slH, k)
        sL   = array.get(slL, k)
        sOp  = array.get(slOpen, k)
        sIn  = array.get(slInNy, k)

        // The trim window opens at the close of the source candle, which
        // happens well before the session ends, so it is measured while the
        // winner is still provisional and carried over when the M object is
        // created. Nothing is drawn during this stage.
        if not na(prov)
            if sT >= prov.t + TF_MS
                prov.wMin := na(prov.wMin) ? sL : math.min(prov.wMin, sL)
                prov.wMax := na(prov.wMax) ? sH : math.max(prov.wMax, sH)

        if array.size(mObjects) > 0
            for i = array.size(mObjects) - 1 to 0
                obj = array.get(mObjects, i)
                bool drop = false

                if not obj.active
                    if sOp
                        // Window closed. What survives is the part of the M
                        // object price never visited, on the side the candle
                        // came from.
                        float newTop = obj.side > 0 ? math.min(obj.top, nz(obj.wMin, obj.top)) : obj.top
                        float newBot = obj.side < 0 ? math.max(obj.bot, nz(obj.wMax, obj.bot)) : obj.bot
                        if newTop <= newBot
                            // Fully absorbed.
                            box.delete(obj.bx)
                            drop := true
                        else
                            obj.top    := newTop
                            obj.bot    := newBot
                            obj.active := true
                            box.set_lefttop(obj.bx, obj.t, newTop)
                            box.set_rightbottom(obj.bx, sT, newBot)
                    else
                        obj.wMin := na(obj.wMin) ? sL : math.min(obj.wMin, sL)
                        obj.wMax := na(obj.wMax) ? sH : math.max(obj.wMax, sH)
                        box.set_right(obj.bx, sT)

                if not drop and obj.active
                    if obj.frozen
                        // The box is settled, but the region stays on the
                        // books so price can still be caught absorbing it.
                        if sT >= obj.expire
                            drop := true
                    else if sH >= obj.bot and sL <= obj.top
                        // Touched: freeze the box where it happened.
                        box.set_right(obj.bx, sT)
                        obj.frozen := true
                    else if sT >= obj.expire
                        box.delete(obj.bx)
                        drop := true
                    else
                        box.set_right(obj.bx, sT)

                // The trim already leaves price on the side the candle came
                // from, so the edge that ends the region is the far one: a
                // bullish region dies on its low, a bearish one on its high.
                // Absorbed during New York, it triggers the NY ID object,
                // and so does an ID object going the same way.
                if not drop and obj.active and not obj.eaten
                    if obj.side > 0 ? sL < obj.bot : sH > obj.top
                        obj.eaten := true
                        if sIn
                            array.set(slEvt, k, true)

                if drop
                    array.remove(mObjects, i)

// ─────────────────────────────  ID OBJECT  ──────────────────────────────
// The region left by the highest-volume H1 candle of the window running
// from the session open to the New York open. Untrimmed, born at the open,
// frozen on touch, gone with its session.

// ──────────  PRE-NEW-YORK SURVIVOR (runs on the H1 series)  ────────────
// Every H1 candle of the window is kept until price absorbs it. The winner
// is the highest-volume candle still standing, so being absorbed hands the
// place to the next one down. Dojis are never candidates: with no side
// there is no edge to lose.

h1PreNySurvivor() =>
    var array<int>   cTime = array.new<int>()
    var array<float> cHigh = array.new<float>()
    var array<float> cLow  = array.new<float>()
    var array<float> cVol  = array.new<float>()
    var array<int>   cSide = array.new<int>()
    var array<bool>  cGone = array.new<bool>()
    var bool inWin = false

    if sessionOpened()
        inWin := true
        array.clear(cTime)
        array.clear(cHigh)
        array.clear(cLow)
        array.clear(cVol)
        array.clear(cSide)
        array.clear(cGone)

    nyMin = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
    // The window closes on the first candle that would run past 09:30 ET.
    // Evening candles sit above 12:00 ET, so they cannot close it early.
    if inWin and nyMin < 720 and nyMin + ID_TF_MIN > NY_OPEN_MIN
        inWin := false

    if inWin
        // Age the candles already stored before adding this one, so a candle
        // is never measured against its own range.
        if array.size(cTime) > 0
            for i = 0 to array.size(cTime) - 1
                if not array.get(cGone, i)
                    if array.get(cSide, i) > 0 ? low < array.get(cLow, i) : high > array.get(cHigh, i)
                        array.set(cGone, i, true)
        candleSide = close > open ? 1 : close < open ? -1 : 0
        if candleSide != 0
            array.push(cTime, time)
            array.push(cHigh, high)
            array.push(cLow,  low)
            array.push(cVol,  volume)
            array.push(cSide, candleSide)
            array.push(cGone, false)

    // Highest volume among the candles still standing. The winner reaches
    // the open un-absorbed by construction: one that had lost its edge would
    // already have dropped out.
    int   bTime = na
    float bHigh = na
    float bLow  = na
    float bVol  = na
    int   bSide = 0
    if array.size(cTime) > 0
        for i = 0 to array.size(cTime) - 1
            if not array.get(cGone, i)
                v = array.get(cVol, i)
                if na(bVol) or v > bVol
                    bVol  := v
                    bTime := array.get(cTime, i)
                    bHigh := array.get(cHigh, i)
                    bLow  := array.get(cLow, i)
                    bSide := array.get(cSide, i)
    [bTime, bHigh, bLow, bVol, bSide]

[idSrcTime, idSrcHigh, idSrcLow, idSrcVol, idSrcSide] = request.security(
     syminfo.tickerid, ID_TF, h1PreNySurvivor(), lookahead = barmerge.lookahead_off)

// ───────────────────────────  STATE  ────────────────────────────────────

var VObject idObj = na                  // the one of this session

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

if isNewSession
    if not na(idObj)
        box.delete(idObj.bx)
    idObj := na

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        sT  = array.get(slT, k)
        sH  = array.get(slH, k)
        sL  = array.get(slL, k)
        sIn = array.get(slInNy, k)

        // Born at the New York open from the highest-volume H1 candle of the
        // pre-NY window that price did not absorb. No trim.
        if enableId and array.get(slOpen, k) and not array.get(slSkip, k) and not na(idSrcTime)
            // Whatever stands here goes first. An orphaned box cannot be
            // reached again, and would sit on the chart for good.
            if not na(idObj)
                box.delete(idObj.bx)
            idObj := VObject.new(t = idSrcTime, top = idSrcHigh,
                 bot = idSrcLow, side = idSrcSide, born = sT)
            idObj.bx := box.new(idSrcTime, idSrcHigh, sT, idSrcLow,
                 xloc         = xloc.bar_time,
                 border_color = idColor,
                 bgcolor      = color.new(idColor, 85))

        // Same rule as an M object: the region projects right until price
        // enters it, then the box freezes where that happened. It is removed
        // with its session, touched or not.
        if not na(idObj) and not idObj.frozen
            box.set_right(idObj.bx, sT)
            if sH >= idObj.bot and sL <= idObj.top
                idObj.frozen := true

        // Absorption is a different matter from being touched, and it keeps
        // being watched after the box settles. A bullish region lives off
        // its low and a bearish one off its high: lose that edge, by a tick,
        // and the region is gone. One absorbed during New York triggers the
        // NY ID object.
        if not na(idObj) and not idObj.eaten
            if idObj.side > 0 ? sL < idObj.bot : sH > idObj.top
                idObj.eaten := true
                if sIn
                    array.set(slEvt, k, true)

// ───────────────────────────  NY ID OBJECT  ─────────────────────────────
// Price absorbing an M object or an ID object during New York is an event.
// Every one of them picks the region again: the highest-volume New York H1
// candle standing at that instant, the one still forming included, read at
// whatever it has reached by then. Between events nothing moves. It ends
// when price absorbs the region in turn, and the session gives no more.

// ───────────────────────────  STATE  ────────────────────────────────────

var VObject nyObj = na                  // the one of this session, its range
                                        // as drawn, which for a candle still
                                        // forming is not its final one

// The H1 candle in progress, accumulated from grid slices. request.security
// cannot hand back an unclosed candle on history, and an unclosed candle is
// exactly what may have to be picked.
var int   curT = na
var float curO = na
var float curH = na
var float curL = na
var float curC = na
var float curV = na

// Every New York H1 candle that has closed, dropped once price takes the
// edge its side lives off, so an absorbed one stays out of the choice.
var array<int>   nyT    = array.new<int>()
var array<float> nyH    = array.new<float>()
var array<float> nyL    = array.new<float>()
var array<float> nyV    = array.new<float>()
var array<int>   nySd   = array.new<int>()
var array<bool>  nyGone = array.new<bool>()

// ────────────────────────  SESSION TURNOVER  ────────────────────────────

if isNewSession
    if not na(nyObj)
        box.delete(nyObj.bx)
    nyObj := na
    curT  := na                         // so the candle straddling the
    curO  := na                         // turnover is not filed under the
    curH  := na                         // session that is starting
    curL  := na
    curC  := na
    curV  := na
    array.clear(nyT)
    array.clear(nyH)
    array.clear(nyL)
    array.clear(nyV)
    array.clear(nySd)
    array.clear(nyGone)

// ──────────────────────────  LIFECYCLE  ─────────────────────────────────

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        sT = array.get(slT, k)
        sO = array.get(slO, k)
        sH = array.get(slH, k)
        sL = array.get(slL, k)
        sC = array.get(slC, k)
        sV = array.get(slV, k)

        if na(curT) or math.floor(sT / ID_TF_MS) != math.floor(curT / ID_TF_MS)
            // The candle that just ended joins the closed ones, unless it
            // closed a doji and so has no edge to lose.
            if not na(curT)
                endedSide  = curC > curO ? 1 : curC < curO ? -1 : 0
                endedNyMin = hour(curT, NY_TZ) * 60 + minute(curT, NY_TZ)
                if endedSide != 0 and endedNyMin >= NY_START_MIN and endedNyMin < NY_END_MIN
                    array.push(nyT,    curT)
                    array.push(nyH,    curH)
                    array.push(nyL,    curL)
                    array.push(nyV,    curV)
                    array.push(nySd,   endedSide)
                    array.push(nyGone, false)
            curT := sT - sT % ID_TF_MS
            curO := sO
            curH := sH
            curL := sL
            curC := sC
            curV := nz(sV)
        else
            curH := math.max(curH, sH)
            curL := math.min(curL, sL)
            curC := sC
            curV := curV + nz(sV)

        // Age the closed ones, so an absorbed candle cannot be chosen later.
        if array.size(nyT) > 0
            for i = 0 to array.size(nyT) - 1
                if not array.get(nyGone, i) and sT >= array.get(nyT, i) + ID_TF_MS
                    if array.get(nySd, i) > 0 ? sL < array.get(nyL, i) : sH > array.get(nyH, i)
                        array.set(nyGone, i, true)

        // Highest volume among the candles still standing, the one in
        // progress included at whatever volume it has reached.
        int   bestT = na
        float bestH = na
        float bestL = na
        float bestV = na
        int   bestS = 0
        if array.size(nyT) > 0
            for i = 0 to array.size(nyT) - 1
                if not array.get(nyGone, i)
                    v = array.get(nyV, i)
                    if na(bestV) or v > bestV
                        bestV := v
                        bestT := array.get(nyT, i)
                        bestH := array.get(nyH, i)
                        bestL := array.get(nyL, i)
                        bestS := array.get(nySd, i)

        curNyMin = na(curT) ? na : hour(curT, NY_TZ) * 60 + minute(curT, NY_TZ)
        curSide  = na(curT) ? 0 : curC > curO ? 1 : curC < curO ? -1 : 0
        if not na(curNyMin) and curNyMin >= NY_START_MIN and curNyMin < NY_END_MIN and curSide != 0
            if na(bestV) or curV > bestV
                bestV := curV
                bestT := curT
                bestH := curH
                bestL := curL
                bestS := curSide

        // Redrawn on every event, and only on an event: a bigger candle
        // closing in between does not take the place on its own.
        if enableNyId and array.get(slEvt, k) and (na(nyObj) or not nyObj.eaten) and not array.get(slSkip, k) and not na(bestT)
            if not na(nyObj)
                box.delete(nyObj.bx)
            nyObj := VObject.new(t = bestT, top = bestH, bot = bestL,
                 side = bestS, born = sT)
            nyObj.bx := box.new(bestT, bestH, sT, bestL,
                 xloc         = xloc.bar_time,
                 border_color = nyIdColor,
                 bgcolor      = color.new(nyIdColor, 85))

        // Measured against the region as drawn, not against what its source
        // candle went on to become.
        if not na(nyObj) and not nyObj.eaten
            box.set_right(nyObj.bx, sT)
            if nyObj.side > 0 ? sL < nyObj.bot : sH > nyObj.top
                nyObj.eaten := true
