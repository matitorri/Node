// ════════════════════════════  LATENT OBJECTS  ══════════════════════════
// See docs/latent-objects.md.
//
// One block per class, then one machine that knows none of them by name.
// A class is a row of parameters, so a fourth is a block and a row, not a
// path through the logic.

// ─────────────────────────────  FAMILY  ─────────────────────────────────

G_L = "Objects · Latent objects"

enableLatent = input.bool(true, "Enable latent objects", group = G_L)
qualifyAt    = input.int(3, "Qualifies at (daily candles)", minval = 1, group = G_L,
     tooltip = "How long a high or a low must survive unbroken to count as a level at all. Below this it is just a high. Where each class ends is declared by the class itself, and the next one begins there.")
showLevels   = input.bool(false, "Draw qualified levels", group = G_L,
     tooltip = "The levels that have qualified and are still waiting for a break. Off by default: there are many more of them than there are objects, and Pine draws a bounded number of shapes.")
keepSpent    = input.int(50, "Retested objects kept", minval = 0, group = G_L,
     tooltip = "A retested object is finished, and stays on the chart to be read. Past this many, the oldest is dropped. The diagnostics report what is alive against what is drawn.")

// ───────────────────────────────  SWI  ──────────────────────────────────

G_SWI = "Objects · Latent objects · Swi"

swiDies  = input.int(7, "Dies at (daily candles)", minval = 1, group = G_SWI)
swiLat   = input.int(1, "Latency (daily candles)", minval = 1, group = G_SWI)
swiZone  = input.float(300, "Zone (points)", minval = 0, group = G_SWI)
swiDraw  = input.bool(true, "Draw", group = G_SWI)
swiColor = input.color(color.new(color.teal, 0), "Color", group = G_SWI)

// ───────────────────────────────  POS  ──────────────────────────────────

G_POS = "Objects · Latent objects · Pos"

posDies  = input.int(21, "Dies at (daily candles)", minval = 1, group = G_POS)
posLat   = input.int(1, "Latency (daily candles)", minval = 1, group = G_POS)
posZone  = input.float(300, "Zone (points)", minval = 0, group = G_POS)
posDraw  = input.bool(true, "Draw", group = G_POS)
posColor = input.color(color.new(color.green, 0), "Color", group = G_POS)

// ───────────────────────────────  INV  ──────────────────────────────────

G_INV = "Objects · Latent objects · Inv"

invDies  = input.int(1021, "Dies at (daily candles)", minval = 1, group = G_INV,
     tooltip = "The end of the last band, and so the age at which a level that was never broken is given up on.")
invLat   = input.int(21, "Latency (daily candles)", minval = 1, group = G_INV)
invZone  = input.float(500, "Zone (points)", minval = 0, group = G_INV)
invDraw  = input.bool(true, "Draw", group = G_INV)
invColor = input.color(color.new(color.maroon, 0), "Color", group = G_INV)

// ──────────────────────────  THE CLASSES  ───────────────────────────────
// The blocks above are read from here and nowhere else. Each class declares
// where it ends and the next one begins there, so a boundary is one number
// and no two of them can disagree. Ascending order is what makes the bands
// consecutive.

var array<string> clsLabel   = array.from("Swi", "Pos", "Inv")
var array<int>    clsDiesAt  = array.from(swiDies, posDies, invDies)
var array<int>    clsLatency = array.from(swiLat, posLat, invLat)
var array<float>  clsZonePts = array.from(swiZone, posZone, invZone)
var array<bool>   clsDraw    = array.from(swiDraw, posDraw, invDraw)
var array<color>  clsTint    = array.from(swiColor, posColor, invColor)

// The class is not stored anywhere. It is the band an age falls in, read
// where it is needed, so nothing can disagree with its own age.
clsOf(int age) =>
    int c = -1
    if age >= qualifyAt
        for k = 0 to array.size(clsDiesAt) - 1
            if c < 0 and age < array.get(clsDiesAt, k)
                c := k
    c

// Past the last band there is nothing left to be promoted to.
lastDies() => array.get(clsDiesAt, array.size(clsDiesAt) - 1)

clsName(int c) => c < 0 ? "—" : array.get(clsLabel, c)

// ──────────────────────────────  TYPES  ─────────────────────────────────

type Level
    float px    = na                    // the price that held
    int   side  = 0                     // +1 left by a high, -1 by a low
    int   srcT  = na                    // when the candle that left it closed
    float inner = na                    // that candle's far side, where a
                                        // zone measured from here stops
    int   age   = 0                     // daily candles survived unbroken
    line  ln    = na

type Latent
    float top    = na
    float bot    = na
    int   side   = 0
    int   cls    = -1
    int   srcT   = na                   // the candle that left the level
    int   brokeT = na                   // where the wait began
    int   left   = 0                    // daily candles it is still latent for
    int   endT   = na                   // where it stops projecting
    bool  hit    = false
    box   bx     = na

var array<Level>  levels  = array.new<Level>()
var array<Latent> latents = array.new<Latent>()

// Two candles can leave the same extreme, and the second would otherwise
// start a level the first is already holding.
hasLevel(float px, int side) =>
    bool found = false
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            if lv.side == side and math.abs(lv.px - px) < syminfo.mintick / 2
                found := true
                break
    found

// ───────────────────────────  THE DAILY FEED  ───────────────────────────
// The previous bar of the higher timeframe, which is the last one closed.
// Read any other way it is still forming, and a level would break on a
// candle that has not finished happening.

[dHigh, dLow, dClose, dTime] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)

newDaily = not na(dTime) and (na(dTime[1]) or dTime != dTime[1])

// ─────────────────────────────  RETEST  ─────────────────────────────────
// On the bar, not on the daily candle: activation is an event, and what
// reads it later will want when, not merely whether. Run before the daily
// step so an object is never tested against the bar it was born on.

if enableLatent and array.size(latents) > 0
    for i = 0 to array.size(latents) - 1
        o = array.get(latents, i)
        if not o.hit and high >= o.bot and low <= o.top
            o.hit  := true
            o.endT := time

// ───────────────────────────  THE DAILY STEP  ───────────────────────────

if enableLatent and newDaily
    // Latency, spent only by objects that were already waiting.
    if array.size(latents) > 0
        for i = array.size(latents) - 1 to 0
            o = array.get(latents, i)
            if not o.hit
                o.left := o.left - 1
                if o.left <= 0
                    box.delete(o.bx)
                    array.remove(latents, i)

    // The levels, against the candle that just closed.
    if array.size(levels) > 0
        for i = array.size(levels) - 1 to 0
            lv = array.get(levels, i)
            bool broke = lv.side > 0 ? dClose > lv.px : dClose < lv.px
            bool wick  = lv.side > 0 ? dHigh > lv.px : dLow < lv.px
            bool drop  = false

            if broke
                int c = clsOf(lv.age)
                if c >= 0
                    float n   = array.get(clsZonePts, c)
                    float top = lv.side > 0 ? lv.px : math.min(lv.px + n, lv.inner)
                    float bot = lv.side > 0 ? math.max(lv.px - n, lv.inner) : lv.px
                    // Latent until its class runs out, and never for less
                    // than the class's latency: a level that breaks late
                    // still gets its minimum.
                    int rest = math.max(array.get(clsDiesAt, c) - lv.age,
                         array.get(clsLatency, c))
                    array.push(latents, Latent.new(top = top, bot = bot,
                         side = lv.side, cls = c, srcT = lv.srcT,
                         brokeT = dTime, left = rest))
                drop := true
            else if wick
                // Price went further than what held, so what held is no
                // longer the level. The extreme it reached is, and this
                // same candle is about to leave it below.
                drop := true
            else
                lv.age := lv.age + 1
                if lv.age >= lastDies()
                    drop := true

            if drop
                line.delete(lv.ln)
                array.remove(levels, i)

    // What the candle leaves behind.
    if not hasLevel(dHigh, 1)
        array.push(levels, Level.new(px = dHigh, side = 1, srcT = dTime, inner = dLow))
    if not hasLevel(dLow, -1)
        array.push(levels, Level.new(px = dLow, side = -1, srcT = dTime, inner = dHigh))

    // A retested object is finished. It is kept to be read, not forever.
    int spent = 0
    if array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            if array.get(latents, i).hit
                spent := spent + 1
    while spent > keepSpent and array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            if array.get(latents, i).hit
                box.delete(array.get(latents, i).bx)
                array.remove(latents, i)
                break
        spent := spent - 1

// ────────────────────────────  DRAWING  ─────────────────────────────────
// Same rule as the V objects: every shape is set from the state that owns
// it, in one place, and never written where a lifecycle happens. The inputs
// decide what is drawn and the diagnostics report what is not, so what the
// chart leaves out is a choice and never an accident.
//
// Unlike the V objects, this runs on the last bar rather than on every one.
// There are five V objects at most; there are hundreds of levels, and a
// pass over all of them on every M1 bar of a year of history is time the
// script does not have. Drawings persist once made, so the last bar is the
// only pass whose result is on the screen — in replay too, where the last
// bar is wherever the replay stands.

var int drawnLevels = 0
var int drawnLatent = 0

if barstate.islast
    drawnLevels := 0
    drawnLatent := 0

    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            int  c    = clsOf(lv.age)
            bool want = showLevels and c >= 0 and array.get(clsDraw, c)
            if want and na(lv.ln)
                lv.ln := line.new(lv.srcT, lv.px, time, lv.px, xloc = xloc.bar_time,
                     color = array.get(clsTint, c), width = 1)
            if not want and not na(lv.ln)
                line.delete(lv.ln)
                lv.ln := na
            if not na(lv.ln)
                line.set_xy1(lv.ln, lv.srcT, lv.px)
                line.set_xy2(lv.ln, time, lv.px)
                line.set_color(lv.ln, array.get(clsTint, c))
                drawnLevels := drawnLevels + 1

    if array.size(latents) > 0
        for i = 0 to array.size(latents) - 1
            o = array.get(latents, i)
            bool want = array.get(clsDraw, o.cls)
            if want and na(o.bx)
                o.bx := box.new(o.srcT, o.top, time, o.bot, xloc = xloc.bar_time,
                     border_color = array.get(clsTint, o.cls),
                     bgcolor      = color.new(array.get(clsTint, o.cls), 85))
            if not want and not na(o.bx)
                box.delete(o.bx)
                o.bx := na
            if not na(o.bx)
                box.set_lefttop(o.bx, o.srcT, o.top)
                box.set_rightbottom(o.bx, na(o.endT) ? time : o.endT, o.bot)
                drawnLatent := drawnLatent + 1
