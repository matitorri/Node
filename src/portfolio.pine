// ═══════════════════════════════  PORTFOLIO  ════════════════════════════
// How much, and whether at all. Strategy only: an indicator has no book.
// Two blocks that never reach into each other. See docs/portfolio.md.

// ────────────────────────  RISK MANAGEMENT  ─────────────────────────────
// Shown one trade and nothing else: the stop distance and a budget.

G_RISK = "Portfolio · Risk management"

RISK_PCT   = "Percent of equity"
RISK_FIXED = "Fixed amount"
EQ_CURRENT = "Current equity"
EQ_INITIAL = "Initial capital"

riskMode   = input.string(RISK_PCT, "Risk per position", options = [RISK_PCT, RISK_FIXED],
     group = G_RISK,
     tooltip = "How the budget for one position is expressed. The amount below is read in whichever unit this names.")
riskQty    = input.float(1.0, "Amount", minval = 0.0, step = 0.1, group = G_RISK,
     tooltip = "A percentage under Percent of equity, an amount of account currency under Fixed amount.")
equityMode = input.string(EQ_CURRENT, "Measured against", options = [EQ_CURRENT, EQ_INITIAL],
     group = G_RISK,
     tooltip = "Current equity compounds: the position grows after a win and shrinks after a loss. Initial capital keeps the risk flat whatever the account has done since. Idle under Fixed amount.")
maxContracts = input.int(10, "Contracts ceiling", minval = 1, group = G_RISK,
     tooltip = "A hard maximum, applied after the budget has spoken. It never raises a size, only caps one.")

riskEquity = equityMode == EQ_INITIAL ? strategy.initial_capital : strategy.equity

riskBudget = riskMode == RISK_FIXED ? riskQty : riskEquity * riskQty / 100.0

// A point of price is worth syminfo.pointvalue, so nothing here is
// specific to one symbol.
riskPerContract = na(tradeExec) or na(tradeLoss) ? na : math.abs(tradeExec - tradeLoss) * syminfo.pointvalue

// Always down. Rounding up would spend more than the budget just declared,
// and a budget short of one contract means no position: there is nothing
// smaller than one contract.
int riskSize = 0
if not na(riskPerContract) and riskPerContract > 0
    riskSize := int(math.floor(riskBudget / riskPerContract))
    if riskSize > maxContracts
        riskSize := maxContracts

// What the account can actually carry, which the budget knows nothing about.
// A size the margin cannot cover is refused by the broker emulator without a
// word: the diagnostics read a size and the book stays flat.
//
// The percentage mirrors margin_long and margin_short in the declaration at
// the top of the script. Pine cannot read those back, so the number lives in
// two places; change both or neither.
MARGIN_PCT = 2.0

marginPerContract = close * syminfo.pointvalue * MARGIN_PCT / 100.0
marginAffords     = marginPerContract > 0 ? int(math.floor(strategy.equity / marginPerContract)) : 0
marginNeeds       = riskSize * marginPerContract

// ────────────────────────  POSITION MANAGER  ────────────────────────────
// Shown the book and the day, never the trade. Three gates on opening,
// and one rule about holding: nothing is carried past the hours.

maxOpen = input.int(1, "Positions at a time", minval = 1, group = G_PM,
     tooltip = "A signal that arrives with the book already this full is ignored. It is not remembered: nothing is taken later on its behalf.")
lossCut = input.int(2, "Losing trades that end the day", minval = 0, group = G_PM,
     tooltip = "Counted from the session opening. Reaching it stops new positions until the next session. Zero turns the cut off.")
winCut  = input.int(1, "Winning trades that end the day", minval = 0, group = G_PM,
     tooltip = "The same on the other side: the day can be ended by going well, not only by going badly. Zero turns the cut off.")

// Profit is net of commission, so a trade scratched to the tick lands on
// the losing side rather than in a third category neither cut would see.
var int pmWins   = 0
var int pmLosses = 0

// The cursor into the closed-trade list. Cumulative over the backtest, so
// unlike the tally it is never reset: that would count old trades again.
var int pmRead = 0

if isNewSession
    pmWins   := 0
    pmLosses := 0

if strategy.closedtrades > pmRead
    for i = pmRead to strategy.closedtrades - 1
        profit = strategy.closedtrades.profit(i)
        if profit > 0
            pmWins += 1
        else if profit < 0
            pmLosses += 1
    pmRead := strategy.closedtrades

pmDayOver = (lossCut > 0 and pmLosses >= lossCut) or (winCut > 0 and pmWins >= winCut)

// Read on the chart bar, since that is where an order would be placed.
pmBarMin  = hour(time, NY_TZ) * 60 + minute(time, NY_TZ)
pmInHours = pmBarMin >= tradingFrom and pmBarMin < tradingTo

pmAllows = pmInHours and not pmDayOver and strategy.opentrades < maxOpen

// The one rule that is not about opening. A target may never be reached,
// so the hours closing is what ends a position that is still running.
pmFlatten = strategy.position_size != 0 and not pmInHours

// ──────────────────────────────  ORDERS  ────────────────────────────────
// Where the two blocks meet: the intention, sized by one and permitted by
// the other. Nothing decides anything here.

// Held for as long as the position is, so the exit does not follow the
// levels a later signal would have used.
var float liveLoss   = na
var float liveTarget = na

if tradeDir != 0 and pmAllows and riskSize > 0
    liveLoss   := tradeLoss
    liveTarget := tradeTarget
    strategy.entry("Node", tradeDir > 0 ? strategy.long : strategy.short, qty = riskSize)

// A na target leaves the stop alone to work: the position then ends on the
// loss or on the hours.
if strategy.position_size != 0
    strategy.exit("Exit", "Node", stop = liveLoss, limit = liveTarget)

if pmFlatten
    strategy.close_all(comment = "Hours")

// ────────────────────────  DIAGNOSTICS  ─────────────────────────────────

if showDiag and barstate.islast
    diagRow(20, "hours",      (pmInHours ? "in" : "out") + "   " + clock(tradingFrom) + " – " + clock(tradingTo))
    diagRow(21, "budget",     str.tostring(riskBudget, "#.##") + (riskMode == RISK_FIXED ? "  fixed" : "  " + str.tostring(riskQty) + "% of " + str.tostring(riskEquity, "#.##")))
    diagRow(22, "per contract", na(riskPerContract) ? "— no trade" : str.tostring(riskPerContract, "#.##"))
    diagRow(23, "size",       str.tostring(riskSize) + (riskSize >= maxContracts ? "  at ceiling" : ""))
    diagRow(24, "open",       str.tostring(strategy.opentrades) + " / " + str.tostring(maxOpen))
    diagRow(25, "session W/L", str.tostring(pmWins) + " / " + str.tostring(pmLosses))
    diagRow(26, "day",        not pmDayOver ? "open" : pmWins >= winCut and winCut > 0 ? "closed · won" : "closed · lost")
    diagRow(27, "allows",     pmAllows ? "yes" : not pmInHours ? "no · outside hours" : pmDayOver ? "no · day is over" : "no · book is full")
    diagRow(29, "margin",     riskSize == 0 ? "—" : str.tostring(marginNeeds, "#.##") + " of " + str.tostring(strategy.equity, "#.##") + (riskSize > marginAffords ? "   REFUSED · affords " + str.tostring(marginAffords) : ""))
    diagRow(28, "position",   strategy.position_size == 0 ? "flat" : (strategy.position_size > 0 ? "long " : "short ") + str.tostring(math.abs(strategy.position_size)) + " @ " + str.tostring(strategy.position_avg_price, format.mintick))
