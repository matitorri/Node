// ══════════════════════════  MARKET STRUCTURE  ══════════════════════════
// A pattern object, and a peer of the V objects rather than a part of them.
// It holds the two levels the structure stands on, the direction they
// imply, and the sequence of points that produced them. Read on M1 whatever
// the chart is on, and unaware of the V objects: crossing the two is the
// setup's job, not the model's.
//
// Candidates are local extremes, one candle either side, no parameter.
// They are dense on purpose. What thins them out is a level, never a size:
//
//   Going up, a candidate high is structural only if it exceeds the last
//   structural high. Everything that fails to is dropped, however large it
//   looked, and the structural low of the interval is simply the lowest
//   candidate low in it. A leg that makes no new high therefore leaves no
//   marks at all, which is why a clean advance reduces to a single line
//   between its two ends.
//
//   Going down, the mirror.
//
// A change of character is price taking a level out: the last structural
// low while going up, the last structural high while going down. Reaching
// through it is enough — a wick counts. Requiring a close was tried and
// read the structure noticeably worse.
//
// Read through request.security rather than by splitting chart bars, which
// keeps the whole history: intrabar requests are capped, a state machine
// running on the M1 series is not.

STRUCT_TF = "1"

G_STRUCT = "Objects · Pattern objects"

enableStruct   = input.bool(true, "Enable market structure", group = G_STRUCT,
     tooltip = "Off publishes nothing: no levels, no direction, no change of character for anything downstream to read.")
showStructPath = input.bool(true,  "Draw the path between points", group = G_STRUCT)
showStructTags = input.bool(false, "Label the points", group = G_STRUCT)
structUpColor  = input.color(color.new(color.teal, 0),   "Up",   group = G_STRUCT)
structDnColor  = input.color(color.new(color.maroon, 0), "Down", group = G_STRUCT)

// ───────────────────────────  THE MACHINE  ──────────────────────────────
// A qualifying candidate brings in two points at once: itself, and the
// extreme of the interval it just closed. Both are handed back, in order.

marketStructure() =>
    var int   phase     = 1             // +1 going up, -1 going down
    var float lastHigh  = na            // the two levels
    var float lastLow   = na
    var float pendHigh  = na            // best candidate since the last
    var int   pendHighT = na            // structural point of the other kind
    var float pendLow   = na
    var int   pendLowT  = na
    var int   ptCount   = 0             // points registered so far
    var int   chCount   = 0             // changes of character so far
    var int   chDir     = 0
    var int   chT       = na

    float aP = na                       // the points this candle produced
    int   aT = na
    bool  aH = false
    float bP = na
    int   bT = na
    bool  bH = false

    cLow  = low[1]  <  low[0]  and low[1]  <= low[2]
    cHigh = high[1] >  high[0] and high[1] >= high[2]

    if na(lastHigh)
        lastHigh := high
        lastLow  := low

    if cLow
        if na(pendLow) or low[1] < pendLow
            pendLow  := low[1]
            pendLowT := time[1]
    if cHigh
        if na(pendHigh) or high[1] > pendHigh
            pendHigh  := high[1]
            pendHighT := time[1]

    bool takeHigh = false
    bool takeLow  = false

    if phase == 1
        if cHigh and high[1] > lastHigh
            takeHigh := true
        if low < lastLow
            phase   := -1
            chCount += 1
            chDir   := -1
            chT     := time
    else
        if cLow and low[1] < lastLow
            takeLow := true
        if high > lastHigh
            phase   := 1
            chCount += 1
            chDir   := 1
            chT     := time

    if takeHigh
        if not na(pendLow)
            aP      := pendLow
            aT      := pendLowT
            aH      := false
            lastLow := pendLow
            ptCount += 1
        bP       := high[1]
        bT       := time[1]
        bH       := true
        lastHigh := high[1]
        ptCount  += 1
        pendLow  := na

    if takeLow
        if not na(pendHigh)
            aP       := pendHigh
            aT       := pendHighT
            aH       := true
            lastHigh := pendHigh
            ptCount  += 1
        bP       := low[1]
        bT       := time[1]
        bH       := false
        lastLow  := low[1]
        ptCount  += 1
        pendHigh := na

    [phase, lastHigh, lastLow, ptCount, aP, aT, aH, bP, bT, bH, chCount, chDir, chT]

[structPhase, structHigh, structLow, structPts,
     sAP, sAT, sAH, sBP, sBT, sBH,
     structChCount, structChDir, structChT] =
     request.security(syminfo.tickerid, STRUCT_TF, marketStructure(),
     lookahead = barmerge.lookahead_off)

// What the rest of the script reads. Disabled, the model publishes nothing.
structOn    = enableStruct
structChoch = structOn and structChCount != nz(structChCount[1], 0)
structNewPt = structOn and structPts != nz(structPts[1], 0)
structColor = structPhase > 0 ? structUpColor : structDnColor
