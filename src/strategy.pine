// ═══════════════════════════════  STRATEGY  ═════════════════════════════
// An intention, not an order. See docs/strategy.md.

G_STRATEGIES = "Strategies"

TGT_OBJECT = "Object"
TGT_R      = "R multiple"

targetMode = input.string(TGT_OBJECT, "Target", options = [TGT_OBJECT, TGT_R],
     group = G_STRATEGIES,
     tooltip = "Object exits at the nearest thing in the way: the day's extreme, or an M object facing the trade. R multiple exits at a fixed multiple of the distance to the loss.")
targetR    = input.float(2.0, "R multiple", minval = 0.1, step = 0.1, group = G_STRATEGIES,
     tooltip = "Idle under the Object target. R is the distance from the execution to the loss.")
useDayEdge = input.bool(true, "Include the day's extreme", group = G_STRATEGIES,
     tooltip = "Under the Object target, let the day's high close a long and the day's low close a short, whichever comes first against an opposing M object. Off leaves only the M objects.")

// ─────────────────────────  THE DAY'S EXTREMES  ─────────────────────────
// Off the grid rather than a daily feed: the day is the exchange session,
// which is what the rest of the model already means by one.

var float dayHigh = na
var float dayLow  = na

if isNewSession
    dayHigh := na
    dayLow  := na

if array.size(slT) > 0
    for k = 0 to array.size(slT) - 1
        sH = array.get(slH, k)
        sL = array.get(slL, k)
        dayHigh := na(dayHigh) ? sH : math.max(dayHigh, sH)
        dayLow  := na(dayLow)  ? sL : math.min(dayLow,  sL)

// ─────────────────────────  M REVERSION  ────────────────────────────────

// The near edge of the closest M object facing the trade, past a price.
// Facing means the opposite side: a long is closed by supply.
oppositeEdge(int dir, float from) =>
    float best = na
    if array.size(mObjects) > 0
        for i = 0 to array.size(mObjects) - 1
            obj = array.get(mObjects, i)
            if obj.active and not obj.eaten and obj.side == -dir
                edge = dir > 0 ? obj.bot : obj.top
                if (dir > 0 ? edge > from : edge < from) and (na(best) or (dir > 0 ? edge < best : edge > best))
                    best := edge
    best

int    tradeDir    = 0                  // +1 long, -1 short, 0 nothing
float  tradeExec   = na
float  tradeLoss   = na                 // where the idea is wrong
float  tradeTarget = na
string tradeFrom   = ""                 // which rule set the target

if signalFired
    float exec = close
    float loss = signalDir > 0 ? dayLow : dayHigh

    // The day's extreme can only sit on the wrong side of the execution by
    // being the execution: price is making it as the signal fires. No
    // distance, no position.
    if not na(loss) and (signalDir > 0 ? loss < exec : loss > exec)
        tradeDir  := signalDir
        tradeExec := exec
        tradeLoss := loss

        if targetMode == TGT_R
            tradeTarget := exec + signalDir * targetR * math.abs(exec - loss)
            tradeFrom   := str.tostring(targetR) + "R"
        else
            float edge    = oppositeEdge(signalDir, exec)
            float dayEdge = signalDir > 0 ? dayHigh : dayLow
            if not na(edge)
                tradeFrom := "opposite M"
            if useDayEdge and not na(dayEdge) and (signalDir > 0 ? dayEdge > exec : dayEdge < exec)
                if na(edge) or (signalDir > 0 ? dayEdge < edge : dayEdge > edge)
                    edge      := dayEdge
                    tradeFrom := "day extreme"
            tradeTarget := edge

// ────────────────────────  DIAGNOSTICS  ─────────────────────────────────

if showDiag and barstate.islast
    diagRow(16, "day range",  na(dayLow) ? "—" : str.tostring(dayLow, format.mintick) + " – " + str.tostring(dayHigh, format.mintick))
    diagRow(17, "intention",  tradeDir == 0 ? "—" : (tradeDir > 0 ? "long" : "short") + " @ " + str.tostring(tradeExec, format.mintick))
    diagRow(18, "loss",       na(tradeLoss) ? "—" : str.tostring(tradeLoss, format.mintick) + "   " + str.tostring(math.abs(tradeExec - tradeLoss), format.mintick) + " away")
    diagRow(19, "target",     na(tradeTarget) ? (tradeDir == 0 ? "—" : "none · time exit only") : str.tostring(tradeTarget, format.mintick) + "   " + tradeFrom)
