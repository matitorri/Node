//@version=6

indicator("Structure lab", overlay = true)

// Pattern objects, step one: the candidates.
//
// A candidate low is a local minimum — a candle whose low sits below the
// one after it and not above the one before it. Candidate highs are the
// mirror. No window, no threshold, no parameter: they are meant to be
// dense, since the filter that picks the structural ones out of them comes
// later.
//
// Built forward rather than scanned backward. Pine runs the whole script
// once per candle, so a loop walking back would redo its own work on every
// bar and cost the square of the history. A local extreme never changes its
// mind once the next candle confirms it, so seeing it once is enough — the
// collection ends up identical.
//
// Runs on the chart's own candles. Open it on the timeframe the structure
// is meant to be read on.

showLows  = input.bool(true, "Candidate lows")
showHighs = input.bool(true, "Candidate highs")
lowColor  = input.color(color.new(color.teal, 0),   "Lows")
highColor = input.color(color.new(color.maroon, 0), "Highs")

// ─────────────────────────────  CANDIDATES  ─────────────────────────────
// Judged on the candle that just closed, which is the first moment both of
// its neighbours are known.

candLow  = low[1]  <  low[0]  and low[1]  <= low[2]
candHigh = high[1] >  high[0] and high[1] >= high[2]

plotshape(showLows  and candLow,  "Candidate low",  shape.circle,
     location.belowbar, color = lowColor,  size = size.tiny, offset = -1)
plotshape(showHighs and candHigh, "Candidate high", shape.circle,
     location.abovebar, color = highColor, size = size.tiny, offset = -1)
