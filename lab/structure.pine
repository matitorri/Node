//@version=6

indicator("Structure lab", overlay = true, max_lines_count = 500, max_labels_count = 500)

// Pattern objects: the structural highs and lows, and the change of
// character that turns the structure.
//
// Candidates are local extremes — one candle either side, no parameter.
// They are dense on purpose. What thins them out is a level, never a size:
//
//   Going up, a candidate high is structural only if it exceeds the last
//   structural high. Everything that fails to is dropped, however large it
//   looked, and the structural low of the interval is simply the lowest
//   candidate low in it. A leg that makes no new high therefore leaves no
//   marks at all, which is why a clean advance reduces to one straight
//   line between two points.
//
//   Going down, the mirror.
//
// A change of character is price taking out the level the structure stands
// on: the last structural low while going up, the last structural high
// while going down. No parameter there either.
//
// Runs on the chart's own candles. Open it on the timeframe the structure
// is meant to be read on.

showCands  = input.bool(false, "Show the candidates underneath")
showLabels = input.bool(true,  "Label the structural points")
upColor    = input.color(color.new(color.teal, 0),   "Up")
dnColor    = input.color(color.new(color.maroon, 0), "Down")

// ─────────────────────────────  CANDIDATES  ─────────────────────────────
// Judged on the candle that just closed, the first moment both neighbours
// are known.

candLow  = low[1]  <  low[0]  and low[1]  <= low[2]
candHigh = high[1] >  high[0] and high[1] >= high[2]

plotshape(showCands and candLow,  "Candidate low",  shape.circle,
     location.belowbar, color = color.new(upColor, 60), size = size.tiny, offset = -1)
plotshape(showCands and candHigh, "Candidate high", shape.circle,
     location.abovebar, color = color.new(dnColor, 60), size = size.tiny, offset = -1)

// ────────────────────────────  REDUCTION  ───────────────────────────────

var int   phase     = 1                 // +1 going up, -1 going down
var float lastHigh  = na                // the structure's two levels
var float lastLow   = na
var float pendHigh  = na                // best candidate since the last
var int   pendHighT = na                // structural point of the other kind
var float pendLow   = na
var int   pendLowT  = na
var float prevP     = na                // last structural point, for the line
var int   prevT     = na
var float prevHigh  = na                // previous structural of each kind,
var float prevLow   = na                // for naming the next one

if na(lastHigh)
    lastHigh := high
    lastLow  := low

// Every candidate feeds the pending extremes; the reduction picks from them.
if candLow
    if na(pendLow) or low[1] < pendLow
        pendLow  := low[1]
        pendLowT := time[1]
if candHigh
    if na(pendHigh) or high[1] > pendHigh
        pendHigh  := high[1]
        pendHighT := time[1]

bool tookHigh = false                   // a structural high was registered
bool tookLow  = false
int  choch    = 0

if phase == 1
    if candHigh and high[1] > lastHigh
        tookHigh := true
    if low < lastLow
        phase := -1
        choch := -1
else
    if candLow and low[1] < lastLow
        tookLow := true
    if high > lastHigh
        phase := 1
        choch := 1

// ───────────────────────────  REGISTER  ─────────────────────────────────
// A qualifying candidate brings in two points: itself, and the extreme of
// the interval it just closed.

if tookHigh
    if not na(pendLow)
        string lowTag = na(prevLow) ? "L" : pendLow < prevLow ? "LL" : "HL"
        if not na(prevT)
            line.new(prevT, prevP, pendLowT, pendLow, xloc = xloc.bar_time,
                 color = dnColor, width = 1)
        if showLabels
            label.new(pendLowT, pendLow, lowTag, xloc = xloc.bar_time,
                 style = label.style_label_up, color = color.new(upColor, 20),
                 textcolor = color.white, size = size.tiny)
        prevLow := pendLow
        prevP   := pendLow
        prevT   := pendLowT
        lastLow := pendLow

    string highTag = na(prevHigh) ? "H" : high[1] > prevHigh ? "HH" : "LH"
    if not na(prevT)
        line.new(prevT, prevP, time[1], high[1], xloc = xloc.bar_time,
             color = upColor, width = 1)
    if showLabels
        label.new(time[1], high[1], highTag, xloc = xloc.bar_time,
             style = label.style_label_down, color = color.new(dnColor, 20),
             textcolor = color.white, size = size.tiny)
    prevHigh := high[1]
    prevP    := high[1]
    prevT    := time[1]
    lastHigh := high[1]
    pendLow  := na

if tookLow
    if not na(pendHigh)
        string hTag = na(prevHigh) ? "H" : pendHigh > prevHigh ? "HH" : "LH"
        if not na(prevT)
            line.new(prevT, prevP, pendHighT, pendHigh, xloc = xloc.bar_time,
                 color = upColor, width = 1)
        if showLabels
            label.new(pendHighT, pendHigh, hTag, xloc = xloc.bar_time,
                 style = label.style_label_down, color = color.new(dnColor, 20),
                 textcolor = color.white, size = size.tiny)
        prevHigh := pendHigh
        prevP    := pendHigh
        prevT    := pendHighT
        lastHigh := pendHigh

    string lTag = na(prevLow) ? "L" : low[1] < prevLow ? "LL" : "HL"
    if not na(prevT)
        line.new(prevT, prevP, time[1], low[1], xloc = xloc.bar_time,
             color = dnColor, width = 1)
    if showLabels
        label.new(time[1], low[1], lTag, xloc = xloc.bar_time,
             style = label.style_label_up, color = color.new(upColor, 20),
             textcolor = color.white, size = size.tiny)
    prevLow  := low[1]
    prevP    := low[1]
    prevT    := time[1]
    lastLow  := low[1]
    pendHigh := na

// ──────────────────────────  WHAT IT STANDS ON  ─────────────────────────

plot(lastHigh, "Structure high", color = color.new(dnColor, 40),
     style = plot.style_stepline, linewidth = 1)
plot(lastLow,  "Structure low",  color = color.new(upColor, 40),
     style = plot.style_stepline, linewidth = 1)

plotshape(choch > 0, "CHoCH up",   shape.triangleup,   location.belowbar,
     color = upColor, size = size.small)
plotshape(choch < 0, "CHoCH down", shape.triangledown, location.abovebar,
     color = dnColor, size = size.small)
